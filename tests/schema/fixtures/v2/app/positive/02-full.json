{
	"$schema": "../../../../../../docs/schemas/admin-app-v2.json",
	"id": "core:editor",
	"version": 1,
	"title": "Block Editor",
	"description": "Full block editor for posts and pages.",
	"role": "main",
	"platform": {
		"dirty-state": true,
		"block-navigation-on-dirty": true,
		"autofocus-target": ".editor-post-title__input"
	},
	"capabilities": [ "edit_posts" ],
	"config-schema": {
		"type": "object",
		"properties": {
			"post-type": { "type": "string" },
			"post-id": { "type": [ "string", "integer" ] }
		},
		"required": [ "post-type" ]
	},
	"extension-points": {
		"PluginSidebar": "@wordpress/editor",
		"PluginDocumentSettingPanel": "@wordpress/editor"
	},
	"script": "core-editor",
	"style": "core-editor"
}
