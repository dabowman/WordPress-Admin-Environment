{
	"$schema": "../../../../../../docs/schemas/admin-app-v2.json",
	"id": "core:posts",
	"version": 1,
	"title": "Posts",
	"role": "main",
	"script": "core-posts",
	"viewConfig": {
		"kind": "postType",
		"name": "post",
		"fieldsRef": "core/post-fields",
		"defaultView": {
			"type": "table",
			"page": 1,
			"perPage": 20,
			"fields": [ "title", "status", "author", "date" ],
			"titleField": "title"
		},
		"defaultLayouts": { "table": {} },
		"actions": [
			{ "id": "edit", "label": "Edit", "isPrimary": true, "icon": "pencil" },
			{ "id": "view", "label": "View", "icon": "external" },
			{ "id": "trash", "label": "Move to Trash", "isDestructive": true, "supportsBulk": true, "icon": "trash" }
		]
	}
}
