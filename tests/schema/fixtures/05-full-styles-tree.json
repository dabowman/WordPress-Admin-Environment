{
	"$schema": "../../../docs/schemas/admin-v1.json",
	"name": "full-styles",
	"version": 1,
	"$wpds": "6.9",
	"settings": {
		"shell": { "layoutEngine": "core:site-editor-layout" },
		"regions": {
			"sidebar": {
				"id": "sidebar",
				"source": "core:sidebar-region",
				"kind": "persistent",
				"capability": "read",
				"contains": [ "nav" ]
			}
		},
		"applications": [
			{ "id": "nav", "source": "core:navigation", "hidden": true }
		]
	},
	"styles": {
		"branding": { "accentColor": "#3858e9", "title": "Acme" },
		"density": "compact",
		"color": {
			"bg": {
				"interactive": {
					"brand": { "strong": "#3858e9", "strong-active": "#2e49d9" }
				}
			}
		},
		"chrome": {
			"sidebar": { "background": "#0a0a0a" }
		},
		"regions": {
			"sidebar": {
				"chrome": { "sidebar": { "background": "#1a1a1a" } }
			}
		}
	}
}
