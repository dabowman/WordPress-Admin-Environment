{
	"$schema": "../../../../../../docs/schemas/admin.json",
	"version": 3,
	"$wpds": "6.9",
	"name": "author-region-routing-mode",
	"engine": "core:default",
	"default-screen": "split",
	"regions": {
		"content": {
			"role": "main",
			"routing": {
				"route-key": "_self"
			}
		},
		"detail": {
			"role": "complementary",
			"routing": {
				"route-key": "detail",
				"mode": "mirror"
			}
		},
		"inspector": {
			"role": "complementary",
			"routing": {
				"route-key": "inspector",
				"mode": "mirror"
			}
		},
		"command-palette": {
			"role": "dialog",
			"routing": {
				"route-key": "palette",
				"mode": "query"
			}
		}
	},
	"screens": {
		"split": {
			"label": "Split",
			"path": "/split",
			"apps": [
				{
					"id": "main",
					"app": "core:posts"
				},
				{
					"id": "peer",
					"app": "core:editor",
					"slot": "detail"
				}
			]
		}
	}
}
