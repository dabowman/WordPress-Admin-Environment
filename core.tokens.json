{
	"$schema": "./docs/schemas/tokens.json",
	"$description": "WP Admin Workspaces core tokens.json baseline. Authors override at theme or site origin (DTCG W3C 2025.10).",

	"color": {
		"$type": "color",

		"brand": {
			"500": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.2196, 0.3451, 0.9137 ]
				}
			},
			"600": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.1137, 0.2078, 0.7059 ]
				}
			}
		},

		"neutral": {
			"0": {
				"$value": { "colorSpace": "srgb", "components": [ 1, 1, 1 ] }
			},
			"50": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.9647, 0.9686, 0.9686 ]
				}
			},
			"100": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.9137, 0.9216, 0.9333 ]
				}
			},
			"300": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.6549, 0.6667, 0.6784 ]
				}
			},
			"600": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.3137, 0.3412, 0.3686 ]
				}
			},
			"800": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.1725, 0.2, 0.2196 ]
				}
			},
			"900": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.1137, 0.1373, 0.1529 ]
				}
			},
			"1000": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.0392, 0.0392, 0.0392 ]
				}
			}
		},

		"feedback": {
			"info": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.2078, 0.5098, 0.7686 ]
				}
			},
			"success": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.1098, 0.5412, 0.3098 ]
				}
			},
			"warning": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.8588, 0.651, 0.0902 ]
				}
			},
			"error": {
				"$value": {
					"colorSpace": "srgb",
					"components": [ 0.8, 0.0941, 0.0941 ]
				}
			}
		}
	},

	"size": {
		"$type": "dimension",
		"xs": { "$value": { "value": 4, "unit": "px" } },
		"sm": { "$value": { "value": 8, "unit": "px" } },
		"md": { "$value": { "value": 12, "unit": "px" } },
		"lg": { "$value": { "value": 16, "unit": "px" } },
		"xl": { "$value": { "value": 24, "unit": "px" } },
		"2xl": { "$value": { "value": 32, "unit": "px" } }
	},

	"radius": {
		"$type": "dimension",
		"sm": { "$value": { "value": 2, "unit": "px" } },
		"md": { "$value": { "value": 4, "unit": "px" } },
		"lg": { "$value": { "value": 8, "unit": "px" } }
	},

	"font": {
		"family": {
			"$type": "fontFamily",
			"system": {
				"$value": [
					"-apple-system",
					"BlinkMacSystemFont",
					"Segoe UI",
					"Roboto",
					"Oxygen-Sans",
					"Ubuntu",
					"Cantarell",
					"Helvetica Neue",
					"sans-serif"
				]
			}
		}
	},

	"duration": {
		"$type": "duration",
		"fast": { "$value": { "value": 100, "unit": "ms" } },
		"normal": { "$value": { "value": 200, "unit": "ms" } }
	}
}
