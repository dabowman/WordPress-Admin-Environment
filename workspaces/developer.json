{
	"$schema": "../docs/schemas/workspace.json",
	"version": 3,
	"$wpds": "6.9",
	"name": "developer",
	"title": "Developer Console",
	"description": "A windowed operations workspace for developers and site operators on the core:desktop engine — content, plugins, users, and diagnostics open side-by-side as desktop windows; classic screens ride the chromeless iframe bridge.",
	"user-switchable": true,
	"engine": "core:desktop",
	"default-screen": "posts",
	"frame": {
		"notices": {
			"snackbar": {
				"app": "core:notices-snackbar"
			}
		}
	},
	"screens": {
		"posts": {
			"label": "Posts",
			"icon": "post",
			"path": "/posts",
			"app": "core:posts",
			"config": {
				"postType": "post"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			}
		},
		"pages": {
			"label": "Pages",
			"icon": "page",
			"path": "/pages",
			"app": "core:posts",
			"config": {
				"postType": "page"
			},
			"permissions": {
				"capabilities": [
					"edit_pages"
				]
			}
		},
		"media": {
			"label": "Media",
			"icon": "media",
			"path": "/media",
			"app": "core:desktop-iframe",
			"config": {
				"url": "upload.php"
			},
			"permissions": {
				"capabilities": [
					"upload_files"
				]
			}
		},
		"users": {
			"label": "Users",
			"icon": "people",
			"path": "/users",
			"app": "core:desktop-iframe",
			"config": {
				"url": "users.php"
			},
			"permissions": {
				"capabilities": [
					"list_users"
				]
			}
		},
		"settings": {
			"label": "Settings",
			"icon": "settings",
			"path": "/settings",
			"app": "core:desktop-iframe",
			"config": {
				"url": "options-general.php"
			},
			"permissions": {
				"capabilities": [
					"manage_options"
				]
			}
		},
		"site-health": {
			"label": "Site Health",
			"icon": "wordpress",
			"path": "/site-health",
			"app": "core:desktop-iframe",
			"config": {
				"url": "site-health.php"
			},
			"permissions": {
				"capabilities": [
					"view_site_health_checks"
				]
			}
		},
		"permalinks": {
			"label": "Permalinks",
			"icon": "external",
			"path": "/permalinks",
			"app": "core:desktop-iframe",
			"config": {
				"url": "options-permalink.php"
			},
			"permissions": {
				"capabilities": [
					"manage_options"
				]
			}
		},
		"command-palette": {
			"label": "Command Palette",
			"slot": "palette",
			"app": "core:command-palette",
			"permissions": {
				"capabilities": [
					"read"
				]
			},
			"mode": "modal"
		},
		"plugins": {
			"label": "Plugins",
			"icon": "plugins",
			"path": "/plugins",
			"app": "core:desktop-iframe",
			"config": {
				"url": "plugins.php"
			},
			"permissions": {
				"capabilities": [
					"activate_plugins"
				]
			}
		}
	},
	"menu": {
		"posts": {
			"position": 10
		},
		"media": {
			"position": 20
		},
		"users": {
			"position": 30
		},
		"pages": {
			"position": 40
		},
		"settings": {
			"position": 50
		},
		"site-health": {
			"position": 60
		},
		"permalinks": {
			"position": 70
		},
		"plugins": {
			"position": 35
		}
	},
	"commands": [
		{
			"id": "core-command-palette",
			"shortcut": "Mod+K",
			"invoke": "core:command-palette",
			"label": "Open Command Palette"
		}
	],
	"regions": {
		"workspace": {
			"app": "core:desktop-compositor"
		},
		"dock": {
			"app": "core:desktop-dock-app",
			"config": {
				"items": [
					{
						"label": "Posts",
						"icon": "post",
						"href": "#/posts"
					},
					{
						"label": "Media",
						"icon": "media",
						"href": "#/media"
					},
					{
						"label": "Users",
						"icon": "people",
						"href": "#/users"
					},
					{
						"label": "Plugins",
						"icon": "plugins",
						"href": "#/plugins"
					},
					{
						"label": "Pages",
						"icon": "page",
						"href": "#/pages"
					},
					{
						"label": "Settings",
						"icon": "settings",
						"href": "#/settings"
					},
					{
						"label": "Site Health",
						"icon": "wordpress",
						"href": "#/site-health"
					},
					{
						"label": "Permalinks",
						"icon": "external",
						"href": "#/permalinks"
					}
				]
			}
		}
	}
}
