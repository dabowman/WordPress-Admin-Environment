{
	"$schema": "../docs/schemas/workspace.json",
	"version": 3,
	"$wpds": "6.9",
	"name": "wp-admin-default",
	"title": "WordPress",
	"description": "The default workspace shipped by WP Admin Workspaces — a recreation of the wp-admin experience with capability-gated screens, classic-menu bridging, and iframe escape hatches for legacy plugin pages.",
	"engine": "core:default",
	"default-screen": "dashboard-home",
	"frame": {
		"branding": {
			"title": "WordPress",
			"logo": null
		},
		"notices": {
			"banner": {
				"app": "core:notices-banner"
			},
			"snackbar": {
				"app": "core:notices-snackbar"
			}
		}
	},
	"settings": {
		"dataViews": {
			"postType": {
				"post": {
					"_default": {
						"fields": [
							{
								"id": "title",
								"type": "text",
								"label": "Title",
								"enableGlobalSearch": true
							},
							{
								"id": "author",
								"type": "text",
								"label": "Author"
							},
							{
								"id": "categories",
								"type": "text",
								"label": "Categories"
							},
							{
								"id": "tags",
								"type": "text",
								"label": "Tags"
							},
							{
								"id": "comments",
								"type": "integer",
								"label": "Comments"
							},
							{
								"id": "date",
								"type": "datetime",
								"label": "Date"
							},
							{
								"id": "status",
								"type": "select",
								"label": "Status",
								"elements": [
									{
										"value": "publish",
										"label": "Published"
									},
									{
										"value": "draft",
										"label": "Draft"
									},
									{
										"value": "pending",
										"label": "Pending Review"
									},
									{
										"value": "future",
										"label": "Scheduled"
									},
									{
										"value": "private",
										"label": "Private"
									},
									{
										"value": "trash",
										"label": "Trash"
									}
								]
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 25,
							"sort": {
								"field": "date",
								"direction": "desc"
							},
							"fields": [
								"title",
								"author",
								"categories",
								"tags",
								"comments",
								"date"
							]
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"isPrimary": true
							},
							{
								"id": "view",
								"label": "View"
							},
							{
								"id": "trash",
								"label": "Move to Trash",
								"isDestructive": true,
								"supportsBulk": true
							}
						],
						"defaultLayouts": {
							"table": {},
							"grid": {}
						}
					},
					"drafts": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "draft"
								}
							]
						}
					},
					"pending": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "pending"
								}
							]
						}
					},
					"trash": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "trash"
								}
							]
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"eligibleWhen": {
									"status": [
										"publish",
										"future",
										"draft",
										"pending",
										"private"
									]
								}
							},
							{
								"id": "view",
								"label": "View",
								"eligibleWhen": {
									"status": [
										"publish",
										"future",
										"draft",
										"pending",
										"private"
									]
								}
							},
							{
								"id": "trash",
								"label": "Move to Trash",
								"eligibleWhen": {
									"status": [
										"publish",
										"future",
										"draft",
										"pending",
										"private"
									]
								}
							},
							{
								"id": "restore",
								"label": "Restore",
								"isPrimary": true,
								"supportsBulk": true,
								"icon": "update",
								"eligibleWhen": {
									"status": "trash"
								}
							},
							{
								"id": "delete-permanent",
								"label": "Delete Permanently",
								"isDestructive": true,
								"supportsBulk": true,
								"icon": "trash",
								"eligibleWhen": {
									"status": "trash"
								}
							}
						]
					}
				},
				"page": {
					"_default": {
						"fields": [
							{
								"id": "title",
								"type": "text",
								"label": "Title",
								"enableGlobalSearch": true
							},
							{
								"id": "author",
								"type": "text",
								"label": "Author"
							},
							{
								"id": "parent",
								"type": "text",
								"label": "Parent"
							},
							{
								"id": "date",
								"type": "datetime",
								"label": "Date"
							},
							{
								"id": "status",
								"type": "select",
								"label": "Status"
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 25,
							"sort": {
								"field": "title",
								"direction": "asc"
							},
							"fields": [
								"status",
								"author",
								"date"
							],
							"titleField": "title"
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"isPrimary": true
							},
							{
								"id": "view",
								"label": "View"
							},
							{
								"id": "trash",
								"label": "Move to Trash",
								"isDestructive": true,
								"supportsBulk": true
							}
						],
						"defaultLayouts": {
							"table": {}
						}
					}
				}
			}
		}
	},
	"screens": {
		"dashboard-home": {
			"label": "Dashboard",
			"icon": "dashboard",
			"description": "Classic wp-admin dashboard through the iframe escape hatch — plugin dashboard widgets render natively.",
			"path": "/dashboard/home",
			"permissions": {
				"capabilities": [
					"read"
				]
			},
			"app": "iframe:index.php"
		},
		"posts": {
			"label": "Posts",
			"icon": "post",
			"description": "Write, edit, and organize posts.",
			"path": "/posts",
			"app": "core:posts",
			"config": {
				"postType": "post",
				"author": "{author}"
			},
			"dataViewRef": "postType/post/_default",
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"legacy_path": "edit.php",
			"legacy_query": {
				"post_type": "post"
			}
		},
		"categories": {
			"label": "Categories",
			"icon": "category",
			"path": "/posts/categories",
			"app": "iframe:edit-tags.php?taxonomy=category",
			"permissions": {
				"capabilities": [
					"manage_categories"
				]
			},
			"legacy_path": "edit-tags.php",
			"legacy_query": {
				"taxonomy": "category"
			}
		},
		"tags": {
			"label": "Tags",
			"icon": "tag",
			"path": "/posts/tags",
			"app": "iframe:edit-tags.php?taxonomy=post_tag",
			"permissions": {
				"capabilities": [
					"manage_categories"
				]
			},
			"legacy_path": "edit-tags.php",
			"legacy_query": {
				"taxonomy": "post_tag"
			}
		},
		"posts-trash": {
			"label": "Trash",
			"icon": "trash",
			"description": "Trashed posts — restore or permanently delete.",
			"path": "/posts/trash",
			"app": "core:posts",
			"config": {
				"postType": "post",
				"status": "trash"
			},
			"dataViewRef": "postType/post/trash",
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"legacy_path": "edit.php",
			"legacy_query": {
				"post_type": "post",
				"post_status": "trash"
			}
		},
		"pages": {
			"label": "Pages",
			"icon": "page",
			"description": "Standalone pages — About, Contact, landing surfaces.",
			"path": "/pages",
			"app": "core:posts",
			"config": {
				"postType": "page"
			},
			"dataViewRef": "postType/page/_default",
			"permissions": {
				"capabilities": [
					"edit_pages"
				]
			},
			"legacy_path": "edit.php",
			"legacy_query": {
				"post_type": "page"
			}
		},
		"media": {
			"label": "Media",
			"icon": "media",
			"description": "Upload, browse, and manage images and files.",
			"path": "/media",
			"app": "iframe:upload.php",
			"permissions": {
				"capabilities": [
					"upload_files"
				]
			},
			"legacy_path": "upload.php",
			"mode": "focus"
		},
		"media-new": {
			"label": "Add Media File",
			"icon": "plus",
			"path": "/media/new",
			"app": "iframe:media-new.php",
			"permissions": {
				"capabilities": [
					"upload_files"
				]
			},
			"mode": "focus",
			"legacy_path": "media-new.php"
		},
		"comments": {
			"label": "Comments",
			"icon": "comments",
			"description": "Moderate comments.",
			"path": "/comments",
			"app": "iframe:edit-comments.php",
			"permissions": {
				"capabilities": [
					"moderate_comments"
				]
			},
			"legacy_path": "edit-comments.php"
		},
		"themes": {
			"label": "Themes",
			"icon": "themes",
			"path": "/themes",
			"app": "iframe:themes.php",
			"permissions": {
				"capabilities": [
					"switch_themes"
				]
			},
			"legacy_path": "themes.php",
			"mode": "focus"
		},
		"site-editor": {
			"label": "Editor",
			"icon": "site-editor",
			"description": "Block-based site editor (templates, parts, styles, navigation).",
			"path": "/site-editor",
			"app": "core:site-editor",
			"permissions": {
				"capabilities": [
					"edit_theme_options"
				]
			},
			"mode": "takeover",
			"legacy_path": "site-editor.php"
		},
		"customize": {
			"label": "Customize",
			"icon": "customize",
			"path": "/customize",
			"app": "iframe:customize.php",
			"permissions": {
				"capabilities": [
					"customize"
				]
			},
			"mode": "takeover"
		},
		"widgets": {
			"label": "Widgets",
			"icon": "widgets",
			"path": "/widgets",
			"app": "iframe:widgets.php",
			"permissions": {
				"capabilities": [
					"edit_theme_options"
				]
			},
			"legacy_path": "widgets.php"
		},
		"menus": {
			"label": "Menus",
			"icon": "navigation",
			"description": "Build and assign classic navigation menus (classic themes).",
			"path": "/menus",
			"app": "iframe:nav-menus.php",
			"permissions": {
				"capabilities": [
					"edit_theme_options"
				]
			},
			"legacy_path": "nav-menus.php"
		},
		"fonts": {
			"label": "Fonts",
			"icon": "typography",
			"path": "/fonts",
			"app": "core:iframe-fallback",
			"config": {
				"url": "themes.php?page=font-library-wp-admin&p=%2Ffont-list"
			},
			"permissions": {
				"capabilities": [
					"edit_theme_options"
				]
			}
		},
		"plugins": {
			"label": "Plugins",
			"icon": "plugins",
			"description": "Install, activate, and manage plugins.",
			"path": "/plugins",
			"app": "iframe:plugins.php",
			"permissions": {
				"capabilities": [
					"activate_plugins"
				]
			},
			"legacy_path": "plugins.php"
		},
		"plugins-new": {
			"label": "Add Plugin",
			"icon": "plus",
			"path": "/plugins/new",
			"app": "iframe:plugin-install.php",
			"permissions": {
				"capabilities": [
					"install_plugins"
				]
			}
		},
		"users": {
			"label": "Users",
			"icon": "users",
			"description": "Manage accounts and roles.",
			"path": "/users",
			"app": "iframe:users.php",
			"permissions": {
				"capabilities": [
					"list_users"
				]
			},
			"legacy_path": "users.php"
		},
		"users-new": {
			"label": "Add New User",
			"icon": "plus",
			"path": "/users/new",
			"app": "iframe:user-new.php",
			"permissions": {
				"capabilities": [
					"create_users"
				]
			},
			"legacy_path": "user-new.php"
		},
		"user-edit": {
			"label": "Edit User",
			"path": "/users/{id}/edit",
			"app": "core:iframe-fallback",
			"config": {
				"url": "user-edit.php?user_id={id}"
			},
			"permissions": {
				"capabilities": [
					"edit_users"
				]
			},
			"legacy_path": "user-edit.php",
			"legacy_params": {
				"id": "user_id"
			}
		},
		"profile": {
			"label": "Profile",
			"icon": "profile",
			"path": "/profile",
			"app": "iframe:profile.php",
			"permissions": {
				"capabilities": [
					"read"
				]
			},
			"legacy_path": "profile.php"
		},
		"tools": {
			"label": "Tools",
			"icon": "tools",
			"path": "/tools",
			"app": "iframe:tools.php",
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"legacy_path": "tools.php"
		},
		"site-health": {
			"label": "Site Health",
			"icon": "heart",
			"path": "/tools/site-health",
			"app": "iframe:site-health.php",
			"permissions": {
				"capabilities": [
					"view_site_health_checks"
				]
			},
			"legacy_path": "site-health.php",
			"mode": "focus"
		},
		"import": {
			"label": "Import",
			"icon": "import",
			"path": "/tools/import",
			"app": "iframe:import.php",
			"permissions": {
				"capabilities": [
					"import"
				]
			},
			"legacy_path": "import.php"
		},
		"export": {
			"label": "Export",
			"icon": "export",
