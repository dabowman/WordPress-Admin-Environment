{
	"$schema": "../docs/schemas/admin-v2.json",
	"version": 1,
	"$wpds": "6.9",
	"name": "desktop-demo",
	"title": "Desktop demo (core:desktop engine)",
	"description": "Demo shell exercising the windowed desktop engine. The three persistent regions (wallpaper, workspace, dock) map to engine templates of the same names. Workspace hosts the compositor app and accepts runtime-mutated child regions (one per open window) via the `core:dynamic-children` platform service. Dock reads the same nav tree as default-engine shells; clicking a tile dispatches `openWindow` to the compositor.",
	"user-switchable": true,

	"engine": "core:desktop",

	"regions": {
		"wallpaper": {
			"template": "core:desktop-wallpaper"
		},

		"workspace": {
			"template": "core:desktop-workspace",
			"app": "core:desktop-compositor"
		},

		"dock": {
			"template": "core:desktop-dock",
			"app": "core:desktop-dock-app",
			"config": {
				"items": [
					{ "label": "Posts", "icon": "post", "href": "#/posts" },
					{ "label": "Media", "icon": "media", "href": "#/media" },
					{ "label": "Users", "icon": "people", "href": "#/users" },
					{ "label": "Pages", "icon": "page", "href": "#/pages" },
					{
						"label": "Settings",
						"icon": "settings",
						"href": "#/settings"
					},
					{
						"label": "Site Health",
						"icon": "wordpress",
						"href": "#/site-health"
					},
					{
						"label": "Permalinks",
						"icon": "external",
						"href": "#/permalinks"
					}
				]
			}
		},

		"notices-snackbar": {
			"role": "region",
			"app": "core:notices-snackbar"
		}
	},

	"routes": {
		"/posts": { "app": "core:posts", "config": { "postType": "post" } },
		"/pages": { "app": "core:posts", "config": { "postType": "page" } },
		"/media": { "app": "core:media" },
		"/users": { "app": "core:users" },
		"/settings": { "app": "core:settings" },
		"/site-health": { "app": "core:site-health" },
		"/permalinks": {
			"app": "core:desktop-iframe",
			"config": { "url": "options-permalink.php" }
		}
	},

	"default-route": "/posts"
}
