{
	"$schema": "../docs/schemas/admin.json",
	"version": 3,
	"$wpds": "6.9",
	"name": "canonical-demo",
	"title": "Canonical Demo",
	"description": "Demonstrates the canonical admin.json shape on the default engine — engine + branding, default-screen, single-app + iframe-fallback screens, a Mod+K command, and a modest theme tweak.",
	"user-switchable": true,
	"workspace": {
		"engine": "core:default",
		"default-screen": "posts",
		"branding": {
			"title": "v2 demo navigation"
		},
		"notices": {
			"banner": {
				"app": "core:notices-banner"
			},
			"snackbar": {
				"app": "core:notices-snackbar"
			}
		}
	},
	"screens": {
		"posts": {
			"label": "Posts",
			"icon": "post",
			"path": "/posts",
			"app": "core:posts",
			"config": {
				"postType": "post"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			}
		},
		"post-new": {
			"label": "New Post",
			"path": "/posts/new",
			"app": "core:simple-editor",
			"config": {
				"postType": "post"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"mode": "focus"
		},
		"post-edit": {
			"label": "Edit Post",
			"path": "/posts/{id}/edit",
			"app": "core:simple-editor",
			"config": {
				"postType": "post",
				"id": "{id}"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"mode": "focus"
		},
		"media": {
			"label": "Media",
			"icon": "media",
			"path": "/media",
			"app": "core:media",
			"permissions": {
				"capabilities": [
					"upload_files"
				]
			}
		},
		"appearance": {
			"label": "Appearance",
			"icon": "brush",
			"path": "/appearance",
			"app": "core:appearance",
			"permissions": {
				"capabilities": [
					"switch_themes"
				]
			}
		},
		"profile": {
			"label": "Profile",
			"icon": "user",
			"path": "/profile",
			"app": "core:profile",
			"permissions": {
				"capabilities": [
					"read"
				]
			}
		},
		"command-palette": {
			"label": "Command Palette",
			"slot": "palette",
			"app": "core:command-palette",
			"permissions": {
				"capabilities": [
					"read"
				]
			},
			"mode": "modal"
		}
	},
	"menu": {
		"posts": {
			"position": 10
		},
		"media": {
			"position": 20
		},
		"sep-1": {
			"separator": true,
			"position": 30
		},
		"appearance": {
			"position": 40
		},
		"profile": {
			"position": 50
		},
		"sep-2": {
			"separator": true,
			"position": 60
		},
		"view-site": {
			"label": "View site",
			"icon": "external",
			"href": "/",
			"external": true,
			"position": 70
		}
	},
	"commands": [
		{
			"id": "core-command-palette",
			"shortcut": "Mod+K",
			"invoke": "core:command-palette",
			"label": "Open Command Palette"
		},
		{
			"id": "navigate-post-new",
			"shortcut": "Mod+Alt+N",
			"navigate": "/posts/new",
			"label": "New post"
		}
	],
	"styles": {
		"theme": {
			"color": {
				"bg": "#fafafa"
			}
		}
	}
}
