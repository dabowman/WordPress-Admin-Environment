{
	"$schema": "../docs/schemas/admin-v2.json",
	"version": 1,
	"$wpds": "6.9",
	"name": "v1-demo",
	"title": "v2 Demo (canonical v2 admin.json shape)",
	"description": "Authored against admin-v2.json. Demonstrates engine templates, nested child regions, the routes block, default-route, per-region routing.route-key, and platform.trigger keystroke binding. First bundled shell migrated to v2 in the joint V2.M2 task 7 + V2.M3 task 8 step.",
	"user-switchable": true,

	"engine": "core:site-editor-layout",

	"regions": {
		"toolbar": {
			"template": "core:topbar",
			"regions": {
				"end": {
					"role": "region",
					"app": "core:toolbar-actions",
					"config": {
						"right": [
							{ "command": "core/new-post", "icon": "plus", "label": "New post" }
						]
					}
				}
			}
		},

		"sidebar": {
			"template": "core:sidebar",
			"regions": {
				"hub": {
					"role": "region",
					"app": "core:site-hub"
				},
				"nav": {
					"role": "navigation",
					"app": "core:navigation",
					"config": {
						"title": "v2 demo navigation",
						"items": [
							{ "label": "Posts",      "icon": "post",  "href": "#/posts" },
							{ "label": "Media",      "icon": "media", "href": "#/media" },
							{ "separator": true },
							{ "label": "Appearance", "icon": "brush", "href": "#/appearance" },
							{ "label": "Profile",    "icon": "user",  "href": "#/profile" },
							{ "separator": true },
							{ "label": "View site",  "icon": "external", "href": "/", "external": true }
						]
					}
				}
			}
		},

		"content": {
			"template": "core:main",
			"routing": { "route-key": "_self" }
		},

		"command-palette": {
			"template": "core:overlay",
			"app": "core:command-picker",
			"platform": {
				"triggerable": true,
				"trigger": { "shortcut": "Mod+K" }
			}
		},

		"notices-banner": {
			"role": "region",
			"app": "core:notices-banner"
		},

		"notices-snackbar": {
			"role": "region",
			"app": "core:notices-snackbar"
		}
	},

	"routes": {
		"/posts":      { "app": "core:posts",      "config": { "postType": "post" } },
		"/media":      { "app": "core:media" },
		"/profile":    { "app": "core:profile" },
		"/appearance": { "app": "core:appearance" }
	},

	"default-route": "/posts",

	"styles": {
		"branding": {
			"title": "v2 Demo",
			"accentColor": "#7c3aed"
		},

		"color": {
			"bg": {
				"interactive": {
					"brand": {
						"strong": "#7c3aed",
						"strong-active": "#6d28d9"
					}
				},
				"surface": {
					"neutral": { "strong": "#ffffff" }
				}
			},
			"fg": {
				"content": {
					"neutral": { "default": "#1e1e1e" }
				}
			},
			"stroke": {
				"focus": { "brand": "#7c3aed" }
			}
		},

		"border": {
			"width": { "focus": "2px" }
		},

		"chrome": {
			"sidebar": {
				"background": "#0f172a",
				"foreground": "#94a3b8",
				"foreground-active": "#e2e8f0",
				"border": "#1e293b",
				"item": {
					"background": "transparent",
					"background-hover": "#1e293b",
					"background-active": "{styles.color.bg.interactive.brand.strong}",
					"foreground": "#e2e8f0",
					"foreground-active": "#ffffff"
				},
				"width": "280px"
			},
			"toolbar": {
				"background": "#0f172a",
				"foreground": "#e2e8f0",
				"border": "#1e293b",
				"height": "48px"
			},
			"site-hub": {
				"background": "#0f172a",
				"foreground": "#ffffff",
				"icon-size": "32px",
				"padding": "12px"
			},
			"content": {
				"background": "#0f172a",
				"card-background": "#ffffff",
				"card-radius": "8px",
				"card-padding": "16px",
				"card-max-width": "1200px"
			}
		},

		"density": "default",

		"userCustomizable": [
			"density",
			"branding.accentColor",
			"color.bg.interactive.brand.strong"
		]
	}
}
