{
  "name": "content-author",
  "title": "Writer",
  "description": "A focused writing environment.",
  "version": 1,
  "layout": {
    "navigation": "left",
    "navigationCollapsed": true
  },
  "applications": [
    {
      "id": "posts",
      "source": "core:posts",
      "title": "Posts",
      "icon": "post",
      "config": { "postType": "post" }
    },
    {
      "id": "pages",
      "source": "core:posts",
      "title": "Pages",
      "icon": "page",
      "config": { "postType": "page" }
    },
    {
      "id": "editor",
      "source": "core:simple-editor",
      "title": "Editor",
      "icon": "edit",
      "hidden": true
    },
    {
      "id": "media",
      "source": "core:media",
      "title": "Media",
      "icon": "media"
