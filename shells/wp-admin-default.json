									"field": "status",
									"operator": "is",
									"value": "trash"
								}
							]
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"eligibleWhen": {
									"status": [
										"publish",
										"future",
										"draft",
										"pending",
										"private"
									]
								}
							},
							{
								"id": "view",
