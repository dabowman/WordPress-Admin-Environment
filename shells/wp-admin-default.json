{
	"$schema": "../docs/schemas/admin.json",
	"version": 3,
	"$wpds": "6.9",
	"name": "wp-admin-default",
	"title": "WordPress",
	"description": "The default workspace shipped by WP Admin Shell — a recreation of the wp-admin experience with capability-gated screens, classic-menu bridging, and iframe escape hatches for legacy plugin pages.",
	"workspace": {
		"engine": "core:default",
		"default-screen": "dashboard-home",
		"branding": {
			"title": "WordPress",
			"logo": null
		},
		"notices": {
			"banner": {
				"app": "core:notices-banner"
			},
			"snackbar": {
				"app": "core:notices-snackbar"
			}
		}
	},
	"settings": {
		"dataViews": {
			"postType": {
				"post": {
					"_default": {
						"fields": [
							{
								"id": "title",
								"type": "text",
								"label": "Title",
								"enableGlobalSearch": true
							},
							{
								"id": "author",
								"type": "text",
								"label": "Author"
							},
							{
								"id": "categories",
								"type": "text",
								"label": "Categories"
							},
							{
								"id": "tags",
								"type": "text",
								"label": "Tags"
							},
							{
								"id": "comments",
								"type": "integer",
								"label": "Comments"
							},
							{
								"id": "date",
								"type": "datetime",
								"label": "Date"
							},
							{
								"id": "status",
								"type": "select",
								"label": "Status",
