									},
									{
										"value": "draft",
										"label": "Draft"
									},
									{
										"value": "pending",
										"label": "Pending Review"
									},
									{
										"value": "future",
										"label": "Scheduled"
									},
									{
										"value": "private",
										"label": "Private"
									},
									{
										"value": "trash",
										"label": "Trash"
									}
								]
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 25,
							"sort": {
								"field": "date",
								"direction": "desc"
							},
							"fields": [
								"title",
								"author",
								"categories",
								"tags",
								"comments",
								"date"
							]
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"isPrimary": true
							},
							{
								"id": "view",
								"label": "View"
							},
							{
								"id": "trash",
								"label": "Move to Trash",
								"isDestructive": true,
								"supportsBulk": true
