	"screens": {
		"dashboard-home": {
			"label": "Dashboard",
			"icon": "dashboard",
			"description": "Site overview, recent activity, drafts at a glance.",
			"path": "/dashboard/home",
			"apps": [
				{
					"id": "host",
					"app": "core:dashboard-host"
				},
				{
					"id": "at-a-glance",
					"app": "core:dashboard-widget-at-a-glance",
					"slot": "grid"
				},
				{
					"id": "activity",
					"app": "core:dashboard-widget-activity",
					"slot": "grid"
				},
				{
					"id": "recent-posts",
					"app": "core:dashboard-widget-recent-posts",
					"slot": "grid"
				},
				{
					"id": "quick-draft",
					"app": "core:dashboard-widget-quick-draft",
					"slot": "grid"
				}
			],
			"permissions": {
				"capabilities": [
					"read"
				]
			}
		},
		"posts": {
			"label": "Posts",
			"icon": "post",
			"description": "Write, edit, and organize posts.",
			"path": "/posts",
			"app": "core:posts",
			"config": {
				"postType": "post",
				"author": "{author}"
			},
			"dataViewRef": "postType/post/_default",
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"legacy_path": "edit.php",
			"legacy_query": {
				"post_type": "post"
			}
		},
		"posts-new": {
			"label": "Add New Post",
			"icon": "plus",
			"path": "/posts/new",
			"app": "core:editor",
			"config": {
				"postType": "post"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"mode": "takeover",
			"legacy_path": "post-new.php",
			"legacy_query": {
				"post_type": "post"
			}
		},
		"post-edit": {
			"label": "Edit Post",
			"path": "/posts/{id}/edit",
			"app": "core:editor",
			"config": {
				"postType": "post",
				"id": "{id}"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"mode": "takeover"
		},
