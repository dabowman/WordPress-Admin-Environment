{
	"$schema": "../docs/schemas/admin-v3.json",
	"version": 3,
	"$wpds": "6.9",
	"name": "wp-admin-default",
	"title": "WordPress",
	"description": "The default workspace shipped by WP Admin Shell — a recreation of the wp-admin experience with capability-gated screens, classic-menu bridging, and iframe escape hatches for legacy plugin pages.",
	"workspace": {
		"engine": "core:default",
		"default-screen": "dashboard-home",
		"branding": {
			"title": "WordPress",
			"logo": null
		},
		"notices": {
			"banner": {
				"app": "core:notices-banner"
			},
			"snackbar": {
				"app": "core:notices-snackbar"
			}
		}
	},
	"settings": {
		"dataViews": {
			"postType": {
				"post": {
					"_default": {
						"fields": [
							{
								"id": "title",
								"type": "text",
								"label": "Title",
								"enableGlobalSearch": true
							},
							{
								"id": "author",
								"type": "text",
								"label": "Author"
							},
							{
								"id": "categories",
								"type": "text",
								"label": "Categories"
							},
							{
								"id": "tags",
								"type": "text",
								"label": "Tags"
							},
							{
								"id": "comments",
								"type": "integer",
								"label": "Comments"
							},
							{
								"id": "date",
								"type": "datetime",
								"label": "Date"
							},
							{
								"id": "status",
								"type": "select",
								"label": "Status",
								"elements": [
									{
										"value": "publish",
										"label": "Published"
									},
									{
										"value": "draft",
										"label": "Draft"
									},
									{
										"value": "pending",
										"label": "Pending Review"
									},
									{
										"value": "future",
										"label": "Scheduled"
									},
									{
										"value": "private",
										"label": "Private"
									},
									{
										"value": "trash",
										"label": "Trash"
									}
								]
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 25,
							"sort": {
								"field": "date",
								"direction": "desc"
							},
							"fields": [
								"title",
								"author",
								"categories",
								"tags",
								"comments",
								"date"
							]
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"isPrimary": true
							},
							{
								"id": "view",
								"label": "View"
							},
							{
								"id": "trash",
								"label": "Move to Trash",
								"isDestructive": true,
								"supportsBulk": true
							}
						],
						"defaultLayouts": {
							"table": {},
							"grid": {}
						}
					},
					"drafts": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "draft"
								}
							]
						}
					},
					"pending": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "pending"
								}
							]
						}
					},
					"trash": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "trash"
								}
							]
						},
						"actions": [
							{
								"id": "restore",
								"label": "Restore",
								"isPrimary": true,
								"supportsBulk": true,
								"eligibleWhen": {
									"status": "trash"
								}
							},
							{
								"id": "delete-permanent",
								"label": "Delete Permanently",
								"isDestructive": true,
								"supportsBulk": true,
								"eligibleWhen": {
									"status": "trash"
								}
							}
						]
					}
				},
				"page": {
					"_default": {
						"fields": [
							{
								"id": "title",
								"type": "text",
								"label": "Title",
								"enableGlobalSearch": true
							},
							{
								"id": "author",
								"type": "text",
								"label": "Author"
							},
							{
								"id": "parent",
								"type": "text",
								"label": "Parent"
							},
							{
								"id": "date",
								"type": "datetime",
								"label": "Date"
							},
							{
								"id": "status",
								"type": "select",
								"label": "Status"
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 25,
							"sort": {
								"field": "title",
								"direction": "asc"
							},
							"fields": [
								"status",
								"author",
								"date"
							],
							"titleField": "title"
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"isPrimary": true
							},
							{
								"id": "view",
								"label": "View"
							},
							{
								"id": "trash",
								"label": "Move to Trash",
								"isDestructive": true,
								"supportsBulk": true
							}
						],
						"defaultLayouts": {
							"table": {}
						}
					}
				}
			},
			"root": {
				"user": {
					"_default": {
						"fields": [
							{
								"id": "name",
								"type": "text",
								"label": "Name",
								"enableGlobalSearch": true,
								"enableHiding": false
							},
							{
								"id": "username",
								"type": "text",
								"label": "Username",
								"enableGlobalSearch": true
							},
							{
								"id": "email",
								"type": "email",
								"label": "Email",
								"enableGlobalSearch": true
							},
							{
								"id": "roles",
								"type": "text",
								"label": "Role",
								"filterBy": {
									"operators": [
										"isAny"
									]
								},
								"elements": [
									{
										"value": "administrator",
										"label": "Administrator"
									},
									{
										"value": "editor",
										"label": "Editor"
									},
									{
										"value": "author",
										"label": "Author"
									},
									{
										"value": "contributor",
										"label": "Contributor"
									},
									{
										"value": "subscriber",
										"label": "Subscriber"
									}
								]
							},
							{
								"id": "registered_date",
								"type": "datetime",
								"label": "Registered"
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 25,
							"fields": [
								"username",
								"email",
								"roles",
								"registered_date"
							],
							"titleField": "name"
						},
						"actions": [
							{
								"id": "edit",
								"label": "Edit",
								"isPrimary": true
							},
							{
								"id": "delete",
								"label": "Delete",
								"isDestructive": true,
								"supportsBulk": true
							}
						],
						"defaultLayouts": {
							"table": {}
						}
					},
					"administrators": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "roles",
									"operator": "isAny",
									"value": [
										"administrator"
									]
								}
							]
						}
					}
				},
				"comment": {
					"_default": {
						"fields": [
							{
								"id": "author",
								"type": "text",
								"label": "Author",
								"enableGlobalSearch": true
							},
							{
								"id": "content",
								"type": "text",
								"label": "Comment",
								"enableGlobalSearch": true,
								"enableSorting": false
							},
							{
								"id": "status",
								"type": "text",
								"label": "Status",
								"filterBy": {
									"operators": [
										"isAny"
									]
								},
								"elements": [
									{
										"value": "approved",
										"label": "Approved"
									},
									{
										"value": "hold",
										"label": "Pending"
									},
									{
										"value": "spam",
										"label": "Spam"
									},
									{
										"value": "trash",
										"label": "Trash"
									}
								]
							},
							{
								"id": "date",
								"type": "datetime",
								"label": "Submitted"
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 25,
							"fields": [
								"author",
								"content",
								"status",
								"date"
							]
						},
						"actions": [
							{
								"id": "approve",
								"label": "Approve",
								"supportsBulk": true,
								"eligibleWhen": {
									"status": [
										"hold",
										"spam",
										"trash"
									]
								}
							},
							{
								"id": "spam",
								"label": "Mark as Spam",
								"supportsBulk": true,
								"isDestructive": true
							},
							{
								"id": "trash",
								"label": "Move to Trash",
								"supportsBulk": true,
								"isDestructive": true
							},
							{
								"id": "reply",
								"label": "Reply"
							}
						],
						"defaultLayouts": {
							"table": {}
						}
					},
					"pending": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "hold"
								}
							]
						}
					},
					"spam": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "spam"
								}
							]
						}
					},
					"trash": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "trash"
								}
							]
						}
					}
				},
				"plugin": {
					"_default": {
						"fields": [
							{
								"id": "name",
								"type": "text",
								"label": "Plugin",
								"enableGlobalSearch": true
							},
							{
								"id": "description",
								"type": "text",
								"label": "Description"
							},
							{
								"id": "version",
								"type": "text",
								"label": "Version"
							},
							{
								"id": "status",
								"type": "select",
								"label": "Status",
								"elements": [
									{
										"value": "active",
										"label": "Active"
									},
									{
										"value": "inactive",
										"label": "Inactive"
									}
								]
							}
						],
						"defaultView": {
							"type": "table",
							"perPage": 50,
							"fields": [
								"name",
								"status",
								"version"
							],
							"titleField": "name"
						},
						"actions": [
							{
								"id": "activate",
								"label": "Activate",
								"eligibleWhen": {
									"status": "inactive"
								}
							},
							{
								"id": "deactivate",
								"label": "Deactivate",
								"eligibleWhen": {
									"status": "active"
								}
							},
							{
								"id": "delete",
								"label": "Delete",
								"isDestructive": true,
								"eligibleWhen": {
									"status": "inactive"
								}
							}
						],
						"defaultLayouts": {
							"table": {}
						}
					},
					"active": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "active"
								}
							]
						}
					},
					"inactive": {
						"extends": "_default",
						"defaultView": {
							"filters": [
								{
									"field": "status",
									"operator": "is",
									"value": "inactive"
								}
							]
						}
					}
				},
				"theme": {
					"_default": {
						"fields": [
							{
								"id": "name",
								"type": "text",
								"label": "Theme"
							},
							{
								"id": "screenshot",
								"type": "media",
								"label": "Screenshot"
							},
							{
								"id": "version",
								"type": "text",
								"label": "Version"
							},
							{
								"id": "author",
								"type": "text",
								"label": "Author"
							}
						],
						"defaultView": {
							"type": "grid",
							"perPage": 24,
							"fields": [
								"status",
								"description",
								"version",
								"author"
							],
							"titleField": "name"
						},
						"actions": [
							{
								"id": "activate",
								"label": "Activate",
								"isPrimary": true,
								"eligibleWhen": {
									"status": "inactive"
								}
							},
							{
								"id": "details",
								"label": "Details"
							}
						],
						"defaultLayouts": {
							"grid": {},
							"table": {}
						}
					}
				}
			}
		}
	},
	"screens": {
		"dashboard": {
			"label": "Dashboard",
			"icon": "dashboard",
			"description": "Site overview and core updates.",
			"path": "/dashboard",
			"app": "core:dashboard",
			"permissions": {
				"capabilities": [
					"read"
				]
			}
		},
		"dashboard-home": {
			"label": "Home",
			"icon": "home",
			"description": "Site overview, recent activity, drafts at a glance.",
			"path": "/dashboard/home",
			"app": "core:dashboard",
			"permissions": {
				"capabilities": [
					"read"
				]
			}
		},
		"dashboard-widgets": {
			"label": "Widgets",
			"icon": "grid",
			"path": "/dashboard/widgets",
			"apps": [
				{
					"id": "host",
					"app": "core:dashboard-host"
				},
				{
					"id": "recent-posts",
					"app": "core:dashboard-widget-recent-posts",
					"slot": "grid"
				},
				{
					"id": "quick-draft",
					"app": "core:dashboard-widget-quick-draft",
					"slot": "grid"
				}
			],
			"permissions": {
				"capabilities": [
					"edit_dashboard"
				]
			}
		},
		"dashboard-updates": {
			"label": "Updates",
			"icon": "update",
			"path": "/dashboard/updates",
			"app": "iframe:update-core.php",
			"permissions": {
				"capabilities": [
					"update_core"
				]
			}
		},
		"posts": {
			"label": "Posts",
			"icon": "post",
			"description": "Write, edit, and organize posts.",
			"path": "/posts",
			"app": "core:posts",
			"config": {
				"postType": "post"
			},
			"dataViewRef": "postType/post/_default",
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			}
		},
		"posts-drafts": {
			"label": "Drafts",
			"icon": "drafts",
			"path": "/posts/drafts",
			"app": "core:posts",
			"config": {
				"postType": "post"
			},
			"dataViewRef": "postType/post/drafts",
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			}
		},
		"posts-pending": {
			"label": "Pending Review",
			"icon": "drafts",
			"path": "/posts/pending",
			"app": "core:posts",
			"config": {
				"postType": "post"
			},
			"dataViewRef": "postType/post/pending",
			"permissions": {
				"capabilities": [
					"edit_others_posts"
				]
			}
		},
		"posts-trash": {
			"label": "Trash",
			"icon": "trash",
			"path": "/posts/trash",
			"app": "core:posts",
			"config": {
				"postType": "post"
			},
			"dataViewRef": "postType/post/trash",
			"permissions": {
				"capabilities": [
					"delete_posts"
				]
			}
		},
		"posts-new": {
			"label": "Add New Post",
			"icon": "plus",
			"path": "/posts/new",
			"app": "core:editor",
			"config": {
				"postType": "post"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"mode": "focus"
		},
		"post-edit": {
			"label": "Edit Post",
			"path": "/posts/{id}/edit",
			"app": "core:editor",
			"config": {
				"postType": "post",
				"postId": "{id}"
			},
			"permissions": {
				"capabilities": [
					"edit_posts"
				]
			},
			"mode": "focus"
		},
		"categories": {
			"label": "Categories",
			"icon": "category",
			"path": "/posts/categories",
			"app": "core:taxonomy",
			"config": {
				"taxonomy": "category"
			},
			"permissions": {
				"capabilities": [
					"manage_categories"
				]
			}
		},
		"tags": {
			"label": "Tags",
			"icon": "tag",
			"path": "/posts/tags",
			"app": "core:taxonomy",
			"config": {
				"taxonomy": "post_tag"
			},
			"permissions": {
				"capabilities": [
					"manage_categories"
				]
			}
		},
		"pages": {
			"label": "Pages",
			"icon": "page",
			"description": "Standalone pages — About, Contact, landing surfaces.",
			"path": "/pages",
			"app": "core:posts",
			"config": {
				"postType": "page"
			},
			"dataViewRef": "postType/page/_default",
			"permissions": {
				"capabilities": [
					"edit_pages"
				]
			}
		},
		"page-edit": {
			"label": "Edit Page",
			"path": "/pages/{id}/edit",
			"app": "core:editor",
			"config": {
				"postType": "page",
				"postId": "{id}"
			},
			"permissions": {
				"capabilities": [
					"edit_pages"
				]
			},
			"mode": "focus"
		},
		"media": {
			"label": "Media",
			"icon": "media",
			"description": "Upload, browse, and manage images and files.",
			"path": "/media",
			"app": "core:media",
			"permissions": {
				"capabilities": [
					"upload_files"
				]
			}
		},
		"comments": {
			"label": "Comments",
			"icon": "comments",
			"description": "Moderate comments.",
			"path": "/comments",
			"app": "core:comments",
			"dataViewRef": "root/comment/_default",
			"permissions": {
				"capabilities": [
					"moderate_comments"
				]
			}
		},
		"appearance": {
			"label": "Appearance",
			"icon": "appearance",
			"description": "Themes, customizer, widgets.",
			"path": "/appearance",
			"app": "core:appearance",
			"permissions": {
				"capabilities": [
					"switch_themes"
				]
			}
		},
		"themes": {
			"label": "Themes",
			"icon": "themes",
			"path": "/themes",
			"app": "core:themes",
			"dataViewRef": "root/theme/_default",
			"permissions": {
				"capabilities": [
					"switch_themes"
				]
			}
		},
		"site-editor": {
			"label": "Editor",
			"icon": "site-editor",
			"description": "Block-based site editor (templates, parts, styles, navigation).",
			"path": "/site-editor",
			"app": "core:site-editor",
			"permissions": {
				"capabilities": [
					"edit_theme_options"
				]
			},
			"mode": "focus"
		},
		"customize": {
			"label": "Customize",
			"icon": "customize",
			"path": "/customize",
			"app": "iframe:customize.php",
			"permissions": {
				"capabilities": [
					"customize"
				]
			},
			"mode": "takeover"
		},
		"widgets": {
			"label": "Widgets",
			"icon": "widgets",
			"path": "/widgets",
			"app": "iframe:widgets.php",
			"permissions": {
				"capabilities": [
					"edit_theme_options"
				]
			}
		},
		"plugins": {
