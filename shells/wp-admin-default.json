{
	"$schema": "../docs/schemas/admin-v2.json",
	"version": 1,
	"$wpds": "6.9",
	"name": "wp-admin-default",
	"title": "WordPress",
	"description": "Default shell. Reconstructs stock wp-admin from the shell's native apps + view-configs, falling back to iframes only for screens with no REST surface (customizer, classic widgets/menus, plugin install/editor, import/export, personal-data tools). Drafts/pending/trash/spam variants ship as view-config entries; capability-pruned nav + 4-layer cap gating remove inaccessible screens per role.",
	"engine": "core:default",
	"preload": [
		"/wp/v2/users/me?context=edit",
		"/wp/v2/types?context=view",
		"/wp/v2/taxonomies?context=view",
		"/wp/v2/statuses?context=view",
		"/wp/v2/themes?status=active",
		[
			"/wp/v2/settings",
			"GET"
		],
		[
			"/wp/v2/settings",
			"OPTIONS"
		]
	],
	"fieldCollections": {
		"wp-admin/post-fields": {
			"kind": "postType",
			"name": null,
			"fields": [
				{
					"id": "title",
					"type": "text",
					"label": "Title",
					"enableGlobalSearch": true,
					"enableHiding": false
				},
				{
					"id": "status",
					"type": "text",
					"label": "Status",
					"filterBy": {
						"operators": [
							"isAny"
						]
					},
					"elements": [
						{
							"value": "publish",
							"label": "Published"
						},
						{
							"value": "future",
							"label": "Scheduled"
						},
						{
							"value": "draft",
							"label": "Draft"
						},
						{
							"value": "pending",
							"label": "Pending Review"
						},
						{
							"value": "private",
							"label": "Private"
						},
						{
							"value": "trash",
							"label": "Trash"
						}
					]
				},
				{
					"id": "author",
					"type": "text",
					"label": "Author",
					"filterBy": {
						"operators": [
							"isAny"
						]
					}
				},
				{
					"id": "date",
					"type": "datetime",
					"label": "Date"
				}
			]
		},
		"wp-admin/user-fields": {
			"kind": "root",
			"name": "user",
			"fields": [
				{
					"id": "name",
					"type": "text",
					"label": "Name",
					"enableGlobalSearch": true,
					"enableHiding": false
				},
				{
					"id": "username",
					"type": "text",
					"label": "Username",
					"enableGlobalSearch": true
				},
				{
					"id": "email",
					"type": "email",
					"label": "Email",
					"enableGlobalSearch": true
				},
				{
					"id": "roles",
					"type": "text",
					"label": "Role",
					"filterBy": {
						"operators": [
							"isAny"
						]
					},
					"elements": [
						{
							"value": "administrator",
							"label": "Administrator"
						},
						{
							"value": "editor",
							"label": "Editor"
						},
						{
							"value": "author",
							"label": "Author"
						},
						{
							"value": "contributor",
							"label": "Contributor"
						},
						{
							"value": "subscriber",
							"label": "Subscriber"
						}
