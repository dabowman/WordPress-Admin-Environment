{
	"$schema": "../docs/schemas/admin-v2.json",
	"version": 1,
	"$wpds": "6.9",
	"name": "developer-admin",
	"title": "Developer Admin",
	"description": "Full admin shell with access to all WordPress features. Drill-down nav for design (templates / patterns / navigation / styles); iframe fallbacks for plugins / tools.",
	"engine": "core:default",

	"regions": {
		"sidebar": {
			"template": "core:sidebar",
			"regions": {
				"hub": { "role": "region", "app": "core:site-hub" },
				"nav": {
					"role": "navigation",
					"app": "core:navigation",
					"config": {
						"items": [
							{
								"label": "Dashboard",
								"icon": "wordpress",
								"href": "#/dashboard"
							},
							{ "separator": true },
							{
								"label": "Posts",
								"icon": "post",
								"href": "#/posts"
							},
							{
								"label": "Drafts",
								"icon": "drafts",
								"href": "#/drafts"
							},
							{
								"label": "Pages",
								"icon": "page",
								"href": "#/pages"
							},
							{
								"label": "Media",
								"icon": "media",
								"href": "#/media"
							},
							{
								"label": "Comments",
								"icon": "comment",
								"href": "#/comments"
							},
							{
								"label": "Categories",
								"icon": "category",
								"href": "#/categories"
							},
							{
								"label": "Tags",
								"icon": "tag",
								"href": "#/tags"
							},
							{ "separator": true },
							{
								"screen": "design",
								"label": "Design",
								"icon": "layout",
								"description": "Edit your site's appearance, navigation, templates, and patterns.",
								"items": [
									{
										"app": "design-styles",
										"label": "Styles",
										"icon": "styles",
										"href": "#/design/styles"
									},
									{
										"app": "design-navigation",
										"label": "Navigation",
										"icon": "navigation",
										"href": "#/design/navigation"
									},
									{
										"app": "design-templates",
										"label": "Templates",
										"icon": "layout",
										"href": "#/design/templates"
									},
									{
										"app": "design-patterns",
										"label": "Patterns",
										"icon": "symbol",
										"href": "#/design/patterns"
									}
								]
							},
							{ "separator": true },
							{
								"screen": "system",
								"label": "System",
								"icon": "settings",
								"description": "Manage plugins, users, tools, and site settings.",
								"items": [
									{
										"label": "Plugins",
										"icon": "plugins",
										"href": "#/plugins"
									},
									{
										"label": "Themes",
										"icon": "styles",
										"href": "#/themes"
									},
									{
										"label": "Users",
										"icon": "people",
										"href": "#/users"
									},
									{
										"label": "Tools",
										"icon": "wrench",
										"href": "#/tools"
									},
									{
										"label": "Site Health",
										"icon": "update",
										"href": "#/site-health"
									},
									{
										"label": "Settings",
										"icon": "settings",
										"href": "#/settings"
									}
								]
							},
							{ "separator": true },
							{
								"label": "View Site",
								"icon": "external",
								"href": "/",
								"external": true
							}
						]
					}
				}
			}
		},

		"content": {
			"template": "core:main",
			"routing": { "route-key": "_self" }
		},

		"command-palette": {
			"template": "core:overlay",
			"app": "core:command-palette",
			"platform": {
				"core:triggerable": true,
				"core:trigger": { "shortcut": "Mod+K" }
			}
		},

		"notices-banner": { "role": "region", "app": "core:notices-banner" },
		"notices-snackbar": { "role": "region", "app": "core:notices-snackbar" }
	},

	"routes": {
		"/posts": { "app": "core:posts", "config": { "postType": "post" } },
		"/drafts": { "app": "core:posts", "config": { "postType": "post", "variant": "drafts" } },
		"/posts/new": {
			"app": "core:simple-editor",
			"config": { "postType": "post" }
		},
		"/posts/{id}/edit": {
			"app": "core:simple-editor",
			"config": { "postType": "post", "id": "{id}" }
		},
		"/pages": { "app": "core:posts", "config": { "postType": "page" } },
		"/pages/new": {
			"app": "core:simple-editor",
			"config": { "postType": "page" }
		},
		"/pages/{id}/edit": {
			"app": "core:simple-editor",
			"config": { "postType": "page", "id": "{id}" }
		},
		"/media": {
			"app": "core:iframe-fallback",
			"config": { "url": "upload.php" }
		},
		"/comments": { "app": "core:comments" },
		"/design/styles": {
			"app": "core:site-editor",
			"config": { "url": "site-editor.php?p=%2Fstyles&canvas=edit" }
		},
		"/design/navigation": {
			"app": "core:posts",
			"config": { "postType": "wp_navigation" }
		},
		"/design/templates": {
			"app": "core:posts",
			"config": { "postType": "wp_template" }
		},
		"/design/patterns": {
			"app": "core:posts",
			"config": { "postType": "wp_block" }
		},
		"/dashboard": { "app": "core:dashboard" },
		"/plugins": { "app": "core:plugins" },
		"/themes": { "app": "core:themes" },
		"/users": { "app": "core:users" },
		"/tools": { "app": "core:tools" },
		"/site-health": { "app": "core:site-health" },
		"/categories": {
			"app": "core:taxonomy",
			"config": { "taxonomy": "category" }
		},
		"/tags": {
			"app": "core:taxonomy",
			"config": { "taxonomy": "post_tag" }
		},
		"/settings": { "app": "core:settings" },
		"/profile": { "app": "core:profile" }
	},

	"default-route": "/posts",

	"bindings": [ { "shortcut": "Mod+K", "invoke": "core:command-palette" } ],

	"fieldCollections": {
		"developer/post-fields": {
			"kind": "postType",
			"name": null,
			"fields": [
				{ "id": "title",  "type": "text",     "label": "Title",  "enableGlobalSearch": true, "enableHiding": false },
				{ "id": "status", "type": "text",     "label": "Status", "filterBy": { "operators": [ "isAny" ] } },
				{ "id": "author", "type": "text",     "label": "Author" },
				{ "id": "date",   "type": "datetime", "label": "Date" }
			]
		}
	},

	"viewConfigs": {
		"postType": {
			"post": {
				"_default": {
					"fieldsRef": "developer/post-fields",
					"defaultView": {
						"type": "table",
						"page": 1,
						"perPage": 25,
						"fields": [ "title", "status", "author", "date" ],
						"titleField": "title",
						"sort": { "field": "date", "direction": "desc" }
					},
					"defaultLayouts": { "table": {}, "grid": {} },
					"actions": [
						{ "id": "edit",  "label": "Edit",          "isPrimary": true, "icon": "pencil" },
						{ "id": "view",  "label": "View",          "icon": "external", "eligibleWhen": { "status": "publish" } },
						{ "id": "trash", "label": "Move to Trash", "isDestructive": true, "supportsBulk": true, "icon": "trash" }
					]
				},
				"drafts": {
					"fieldsRef": "developer/post-fields",
					"defaultView": {
						"type": "table",
						"page": 1,
						"perPage": 50,
						"fields": [ "title", "author", "date" ],
						"titleField": "title",
						"sort": { "field": "date", "direction": "desc" },
						"filters": [ { "field": "status", "operator": "is", "value": "draft" } ]
					},
					"actions": [
						{ "id": "edit",  "label": "Resume editing", "isPrimary": true, "icon": "pencil" },
						{ "id": "trash", "label": "Discard draft",  "isDestructive": true, "supportsBulk": true, "icon": "trash" }
					]
				}
			},
			"page": {
				"_default": {
					"fieldsRef": "developer/post-fields",
					"defaultView": {
						"type": "table",
						"page": 1,
						"perPage": 50,
						"fields": [ "title", "status", "author", "date" ],
						"titleField": "title",
						"sort": { "field": "title", "direction": "asc" }
					},
					"defaultLayouts": { "table": {}, "grid": {} },
					"actions": [
						{ "id": "edit",  "label": "Edit",          "isPrimary": true, "icon": "pencil" },
						{ "id": "view",  "label": "View",          "icon": "external", "eligibleWhen": { "status": "publish" } },
						{ "id": "trash", "label": "Move to Trash", "isDestructive": true, "supportsBulk": true, "icon": "trash" }
					]
				}
			},
			"wp_template": {
				"_default": {
					"fields": [
						{ "id": "title", "type": "text",     "label": "Template", "enableGlobalSearch": true, "enableHiding": false },
						{ "id": "date",  "type": "datetime", "label": "Modified" }
					],
					"defaultView": {
						"type": "grid",
						"page": 1,
						"perPage": 24,
						"fields": [ "title", "date" ],
						"titleField": "title",
						"sort": { "field": "date", "direction": "desc" }
					},
					"defaultLayouts": { "grid": {}, "table": {} },
					"actions": [
						{ "id": "edit", "label": "Edit template", "isPrimary": true, "icon": "pencil" }
					]
				}
			},
			"wp_block": {
				"_default": {
					"fields": [
						{ "id": "title", "type": "text",     "label": "Pattern", "enableGlobalSearch": true, "enableHiding": false },
						{ "id": "date",  "type": "datetime", "label": "Created" }
					],
					"defaultView": {
						"type": "grid",
						"page": 1,
						"perPage": 36,
						"fields": [ "title" ],
						"titleField": "title",
						"sort": { "field": "date", "direction": "desc" }
					},
					"defaultLayouts": { "grid": {}, "table": {} },
					"actions": [
						{ "id": "edit", "label": "Edit pattern", "isPrimary": true, "icon": "pencil" }
					]
				}
			},
			"wp_navigation": {
				"_default": {
					"fields": [
						{ "id": "title", "type": "text",     "label": "Menu",    "enableGlobalSearch": true, "enableHiding": false },
						{ "id": "date",  "type": "datetime", "label": "Updated" }
					],
					"defaultView": {
						"type": "table",
						"page": 1,
						"perPage": 25,
						"fields": [ "title", "date" ],
						"titleField": "title",
						"sort": { "field": "date", "direction": "desc" }
					},
					"defaultLayouts": { "table": {}, "grid": {} },
					"actions": [
						{ "id": "edit", "label": "Edit menu", "isPrimary": true, "icon": "pencil" }
					]
				}
			}
		}
	},

	"styles": {
		"theme": {
			"color": {
				"bg": "#1e1e1e"
			},
			"density": "compact"
		},
		"regions": {
			"content": {
				"theme": { "color": { "bg": "#ffffff" } }
			}
		}
	}
}
