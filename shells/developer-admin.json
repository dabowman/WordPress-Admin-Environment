{
  "name": "developer-admin",
  "title": "Developer Admin",
  "description": "Full admin shell with access to all WordPress features.",
  "version": 1,
  "layout": {
    "navigation": "left",
    "navigationCollapsed": false
  },
  "applications": [
    {
      "id": "posts",
      "source": "core:posts",
      "title": "Posts",
      "icon": "post",
      "config": { "postType": "post" }
    },
    {
      "id": "pages",
      "source": "core:posts",
      "title": "Pages",
      "icon": "page",
      "config": { "postType": "page" }
    },
    {
      "id": "editor",
      "source": "core:editor",
      "title": "Editor",
      "icon": "edit",
      "hidden": true
    },
    {
      "id": "media",
      "source": "iframe:upload.php",
      "title": "Media",
      "icon": "media"
    },
    {
      "id": "design-styles",
      "source": "iframe:site-editor.php?p=%2Fstyles&canvas=edit",
      "title": "Styles",
      "icon": "styles"
    },
    {
      "id": "design-navigation",
      "source": "core:posts",
      "title": "Navigation",
      "icon": "navigation",
      "config": { "postType": "wp_navigation" }
    },
    {
      "id": "design-templates",
      "source": "core:posts",
      "title": "Templates",
      "icon": "layout",
      "config": { "postType": "wp_template" }
    },
    {
      "id": "design-patterns",
      "source": "core:posts",
      "title": "Patterns",
      "icon": "symbol",
      "config": { "postType": "wp_block" }
    },
    {
      "id": "plugins",
      "source": "iframe:plugins.php",
      "title": "Plugins",
      "icon": "plugins"
    },
    {
      "id": "users",
      "source": "iframe:users.php",
      "title": "Users",
      "icon": "people"
    },
    {
      "id": "tools",
      "source": "iframe:tools.php",
      "title": "Tools",
      "icon": "wrench"
    },
    {
      "id": "settings-general",
      "source": "core:settings-general",
      "title": "General Settings",
      "icon": "settings"
    },
    {
      "id": "settings",
      "source": "iframe:options-general.php",
      "title": "Settings (legacy)",
      "icon": "settings",
      "hidden": true
    },
    {
      "id": "profile",
      "source": "core:profile",
      "title": "Profile",
      "icon": "user",
      "hidden": true
    }
  ],
  "navigation": [
    { "app": "posts" },
    { "app": "pages" },
    { "app": "media" },
    { "separator": true },
    {
      "screen": "design",
      "label": "Design",
      "icon": "layout",
      "description": "Edit your site's appearance, navigation, templates, and patterns.",
      "items": [
        { "app": "design-styles" },
        { "app": "design-navigation" },
        { "app": "design-templates" },
        { "app": "design-patterns" }
      ]
    },
    { "separator": true },
    {
      "screen": "system",
      "label": "System",
      "icon": "settings",
      "description": "Manage plugins, users, tools, and site settings.",
      "items": [
        { "app": "plugins" },
        { "app": "users" },
        { "app": "tools" },
        { "app": "settings-general" }
      ]
    },
    { "separator": true },
    {
      "label": "View Site",
      "icon": "external",
      "href": "/",
      "external": true
    }
  ],
  "toolbar": {
    "right": [
      {
        "command": "core/new-post",
        "icon": "plus",
        "label": "New"
      },
      {
        "app": "profile",
        "icon": "user",
        "label": "Profile"
      },
      {
        "href": "/",
        "icon": "external",
        "label": "View Site",
        "external": true
      }
    ]
  },
  "defaultApp": "posts"
}
