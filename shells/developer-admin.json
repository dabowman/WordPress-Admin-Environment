{
	"$schema": "../docs/schemas/admin-v2.json",
	"version": 1,
	"$wpds": "6.9",
	"name": "developer-admin",
	"title": "Developer Admin",
	"description": "Full admin shell with access to all WordPress features. Drill-down nav for design (templates / patterns / navigation / styles); iframe fallbacks for plugins / tools.",
	"engine": "core:default",

	"regions": {
		"toolbar": {
			"template": "core:topbar",
			"regions": {
				"end": {
					"role": "region",
					"regions": {
						"actions": {
							"role": "region",
							"app": "core:toolbar-actions",
							"config": {
								"right": [
									{ "command": "core/new-post", "icon": "plus", "label": "New" },
									{ "href": "/", "icon": "external", "label": "View Site", "external": true }
								]
							}
						},
						"user-menu": { "role": "region", "app": "core:user-menu" }
					}
				}
			}
		},

		"sidebar": {
			"template": "core:sidebar",
			"regions": {
				"hub": { "role": "region", "app": "core:site-hub" },
				"nav": {
					"role": "navigation",
					"app": "core:navigation",
					"config": {
						"items": [
							{ "label": "Dashboard", "icon": "wordpress", "href": "#/dashboard" },
							{ "separator": true },
							{ "label": "Posts",      "icon": "post",     "href": "#/posts" },
							{ "label": "Pages",      "icon": "page",     "href": "#/pages" },
							{ "label": "Media",      "icon": "media",    "href": "#/media" },
							{ "label": "Comments",   "icon": "comment",  "href": "#/comments" },
							{ "label": "Categories", "icon": "category", "href": "#/categories" },
							{ "label": "Tags",       "icon": "tag",      "href": "#/tags" },
							{ "separator": true },
							{
								"screen": "design",
								"label": "Design",
								"icon": "layout",
								"description": "Edit your site's appearance, navigation, templates, and patterns.",
								"items": [
									{ "app": "design-styles",    "label": "Styles",     "icon": "styles",     "href": "#/design/styles" },
									{ "app": "design-navigation", "label": "Navigation", "icon": "navigation", "href": "#/design/navigation" },
									{ "app": "design-templates", "label": "Templates",  "icon": "layout",     "href": "#/design/templates" },
									{ "app": "design-patterns",  "label": "Patterns",   "icon": "symbol",     "href": "#/design/patterns" }
								]
							},
							{ "separator": true },
							{
								"screen": "system",
								"label": "System",
								"icon": "settings",
								"description": "Manage plugins, users, tools, and site settings.",
								"items": [
									{ "label": "Plugins",     "icon": "plugins",  "href": "#/plugins" },
									{ "label": "Themes",      "icon": "styles",   "href": "#/themes" },
									{ "label": "Users",       "icon": "people",   "href": "#/users" },
									{ "label": "Tools",       "icon": "wrench",   "href": "#/tools" },
									{ "label": "Site Health", "icon": "update",   "href": "#/site-health" },
									{ "label": "Settings",    "icon": "settings", "href": "#/settings" }
								]
							},
							{ "separator": true },
							{ "label": "View Site", "icon": "external", "href": "/", "external": true }
						]
					}
				}
			}
		},

		"content": {
			"template": "core:main",
			"routing": { "route-key": "_self" }
		},

		"command-palette": {
			"template": "core:overlay",
			"app": "core:command-palette",
			"platform": {
				"triggerable": true,
				"trigger": { "shortcut": "Mod+K" }
			}
		},

		"notices-banner":   { "role": "region", "app": "core:notices-banner" },
		"notices-snackbar": { "role": "region", "app": "core:notices-snackbar" }
	},

	"routes": {
		"/posts":              { "app": "core:posts",            "config": { "postType": "post" } },
		"/posts/new":          { "app": "core:simple-editor",    "config": { "postType": "post" } },
		"/posts/{id}/edit":    { "app": "core:simple-editor",    "config": { "postType": "post", "id": "{id}" } },
		"/pages":              { "app": "core:posts",            "config": { "postType": "page" } },
		"/pages/new":          { "app": "core:simple-editor",    "config": { "postType": "page" } },
		"/pages/{id}/edit":    { "app": "core:simple-editor",    "config": { "postType": "page", "id": "{id}" } },
		"/media":              { "app": "core:iframe-fallback",  "config": { "url": "upload.php" } },
		"/comments":           { "app": "core:comments" },
		"/design/styles":      { "app": "core:site-editor",      "config": { "url": "site-editor.php?p=%2Fstyles&canvas=edit" } },
		"/design/navigation":  { "app": "core:posts",            "config": { "postType": "wp_navigation" } },
		"/design/templates":   { "app": "core:posts",            "config": { "postType": "wp_template" } },
		"/design/patterns":    { "app": "core:posts",            "config": { "postType": "wp_block" } },
		"/dashboard":          { "app": "core:dashboard" },
		"/plugins":            { "app": "core:plugins" },
		"/themes":             { "app": "core:themes" },
		"/users":              { "app": "core:users" },
		"/tools":              { "app": "core:tools" },
		"/site-health":        { "app": "core:site-health" },
		"/categories":         { "app": "core:taxonomy",         "config": { "taxonomy": "category" } },
		"/tags":               { "app": "core:taxonomy",         "config": { "taxonomy": "post_tag" } },
		"/settings":           { "app": "core:settings" },
		"/profile":            { "app": "core:profile" }
	},

	"default-route": "/posts",

	"bindings": [
		{ "shortcut": "Mod+K", "invoke": "core:command-palette" }
	],

	"styles": {
		"theme": {
			"color":   { "primary": "#fff000" },
			"density": "compact"
		},
		"regions": {
			"sidebar": {
				"theme": { "color": { "bg": "#ffffff" } }
			}
		}
	}
}
