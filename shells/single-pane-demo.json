{
	"$schema": "../docs/schemas/admin-v2.json",
	"version": 1,
	"$wpds": "6.9",
	"name": "single-pane-demo",
	"title": "Single Pane Demo",
	"description": "Demo shell exercising the core:single-pane engine. Mobile-style appbar + main pane; navigation collapses to a hamburger drawer.",
	"engine": "core:single-pane",

	"regions": {
		"appbar": {
			"template": "core:appbar",
			"regions": {
				"start": { "role": "region", "app": "core:site-hub" },
				"end": {
					"role": "region",
					"app": "core:toolbar-actions",
					"config": {
						"right": [
							{
								"command": "core/new-post",
								"icon": "plus",
								"label": "New Post"
							}
						]
					}
				}
			}
		},

		"nav": {
			"template": "core:nav-drawer",
			"app": "core:navigation",
			"config": {
				"items": [
					{ "label": "Posts", "icon": "post", "href": "#/posts" },
					{ "label": "Pages", "icon": "page", "href": "#/pages" },
					{ "label": "Media", "icon": "media", "href": "#/media" }
				]
			}
		},

		"main": {
			"template": "core:pane",
			"routing": { "route-key": "_self" }
		},

		"command-palette": {
			"template": "core:overlay",
			"app": "core:command-palette",
			"platform": {
				"triggerable": true,
				"trigger": { "shortcut": "Mod+K" }
			}
		},

		"notices-banner": { "role": "region", "app": "core:notices-banner" },
		"notices-snackbar": { "role": "region", "app": "core:notices-snackbar" }
	},

	"routes": {
		"/posts": { "app": "core:posts", "config": { "postType": "post" } },
		"/posts/new": {
			"app": "core:simple-editor",
			"config": { "postType": "post" }
		},
		"/posts/{id}/edit": {
			"app": "core:simple-editor",
			"config": { "postType": "post", "id": "{id}" }
		},
		"/pages": { "app": "core:posts", "config": { "postType": "page" } },
		"/pages/new": {
			"app": "core:simple-editor",
			"config": { "postType": "page" }
		},
		"/pages/{id}/edit": {
			"app": "core:simple-editor",
			"config": { "postType": "page", "id": "{id}" }
		},
		"/media": {
			"app": "core:iframe-fallback",
			"config": { "url": "upload.php" }
		}
	},

	"default-route": "/posts"
}
