{
  "$schema": "../../../../docs/schemas/admin-engine-v2.json",
  "id": "core:site-editor-layout",
  "version": 1,
  "title": "Site Editor Layout",
  "description": "Default WP Admin Shell engine. Mirrors the site-editor visual idiom: dark chrome with elevated cards. Ships templates for sidebar, topbar (with start/center/end child regions), main, detail, and overlay; applies a dark chrome background and floats main + detail as elevated white cards.",

  "specializes-roles": [
    "navigation",
    "banner",
    "main",
    "complementary",
    "dialog",
    "contentinfo"
  ],

  "honored-platform": [
    "modal",
    "dismiss-on",
    "autofocus-target",
    "triggerable",
    "persists-across-navigation",
    "dirty-state",
    "block-navigation-on-dirty",
    "trigger"
  ],

  "templates": {

    "core:sidebar": {
      "role": "navigation",
      "platform": { "persists-across-navigation": true },
      "default-style": {
        "inline-size":   "280px",
        "block-size":    "100%",
        "background":    "{styles.chrome.sidebar.background}",
        "color":         "{styles.chrome.sidebar.foreground}",
        "padding-block": "{styles.chrome.sidebar.padding-block}",
        "padding-inline": "{styles.chrome.sidebar.padding-inline}"
      }
    },

    "core:topbar": {
      "role": "banner",
      "platform": { "persists-across-navigation": true },
      "default-style": {
        "block-size":    "48px",
        "inline-size":   "100%",
        "background":    "{styles.chrome.toolbar.background}",
        "color":         "{styles.chrome.toolbar.foreground}",
        "padding-inline": "{styles.chrome.toolbar.padding-inline}"
      },
      "regions": {
        "start":  { "role": "region" },
        "center": { "role": "region" },
        "end":    { "role": "region" }
      }
    },

    "core:main": {
      "role": "main",
      "default-style": {
        "inline-size":     "100%",
        "min-inline-size": "0",
        "background":      "{styles.chrome.canvas.background}",
        "padding":         "{styles.chrome.canvas.padding}"
      }
    },

    "core:detail": {
      "role": "complementary",
      "platform": { "dismiss-on": [ "Escape" ] },
      "default-style": {
        "inline-size":         "min(720px, 50%)",
        "min-inline-size":     "320px",
        "block-size":          "100%",
        "border-inline-start": "1px solid {styles.color.stroke.surface.neutral.weak}",
        "background":          "{styles.chrome.canvas.background}"
      }
    },

    "core:overlay": {
      "role": "dialog",
      "platform": { "modal": true, "dismiss-on": [ "Escape", "backdrop-click" ] },
      "default-style": {
        "inline-size":        "min(600px, 90vw)",
        "max-block-size":     "70vh",
        "position":           "fixed",
        "inset-block-start":  "20vh",
        "inset-inline-start": "50%",
        "translate":          "-50% 0"
      }
    }
  },

  "default-arrangement": "wp-chrome",

  "script": "wp-admin-shell",
  "style":  "wp-admin-shell"
}
