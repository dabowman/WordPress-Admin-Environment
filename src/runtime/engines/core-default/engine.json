{
  "$schema": "../../../../docs/schemas/admin-engine-v2.json",
  "id": "core:default",
  "version": 1,
  "title": "Default",
  "description": "Default WP Admin Shell engine. Mirrors the site-editor visual idiom: dark chrome with elevated cards. Ships templates for sidebar, topbar (with start/center/end child regions), main, detail, and overlay; applies a dark chrome background and floats main + detail as elevated white cards.",

  "specializes-roles": [
    "navigation",
    "banner",
    "main",
    "complementary",
    "dialog",
    "contentinfo"
  ],

  "honored-platform": [
    "modal",
    "dismiss-on",
    "autofocus-target",
    "triggerable",
    "persists-across-navigation",
    "dirty-state",
    "block-navigation-on-dirty",
    "trigger"
  ],

  "templates": {

    "core:sidebar": {
      "role": "navigation",
      "platform": { "persists-across-navigation": true },
      "default-style": {
        "inline-size":   "280px",
        "block-size":    "100%",
        "background":    "var(--wp-admin-shell--chrome--sidebar--background, var(--wpds-color-bg-surface-neutral))",
        "color":         "var(--wp-admin-shell--chrome--sidebar--foreground, var(--wpds-color-fg-content-neutral))",
        "padding-block": "var(--wp-admin-shell--chrome--sidebar--padding-block, var(--wpds-dimension-padding-md))",
        "padding-inline": "var(--wp-admin-shell--chrome--sidebar--padding-inline, var(--wpds-dimension-padding-md))"
      }
    },

    "core:topbar": {
      "role": "banner",
      "platform": { "persists-across-navigation": true },
      "default-style": {
        "block-size":    "48px",
        "inline-size":   "100%",
        "background":    "var(--wp-admin-shell--chrome--toolbar--background, var(--wpds-color-bg-surface-neutral-strong))",
        "color":         "var(--wp-admin-shell--chrome--toolbar--foreground, var(--wpds-color-fg-content-neutral))",
        "padding-inline": "var(--wp-admin-shell--chrome--toolbar--padding-inline, var(--wpds-dimension-padding-md))"
      },
      "regions": {
        "start":  { "role": "region" },
        "center": { "role": "region" },
        "end":    { "role": "region" }
      }
    },

    "core:main": {
      "role": "main",
      "default-style": {
        "inline-size":     "100%",
        "min-inline-size": "0",
        "background":      "var(--wp-admin-shell--chrome--canvas--background, var(--wpds-color-bg-surface-neutral-strong))",
        "padding":         "var(--wp-admin-shell--chrome--canvas--padding, var(--wpds-dimension-padding-2xl))"
      }
    },

    "core:detail": {
      "role": "complementary",
      "platform": { "dismiss-on": [ "Escape" ] },
      "default-style": {
        "inline-size":         "min(720px, 50%)",
        "min-inline-size":     "320px",
        "block-size":          "100%",
        "border-inline-start": "1px solid var(--wpds-color-stroke-surface-neutral)",
        "background":          "var(--wp-admin-shell--chrome--canvas--background, var(--wpds-color-bg-surface-neutral-strong))"
      }
    },

    "core:overlay": {
      "role": "dialog",
      "platform": { "modal": true, "dismiss-on": [ "Escape", "backdrop-click" ] },
      "default-style": {
        "inline-size":        "min(600px, 90vw)",
        "max-block-size":     "70vh",
        "position":           "fixed",
        "inset-block-start":  "20vh",
        "inset-inline-start": "50%",
        "translate":          "-50% 0"
      }
    }
  },

  "default-arrangement": "wp-chrome",

  "script": "wp-admin-shell",
  "style":  "wp-admin-shell"
}
