{
	"$schema": "../../../../docs/schemas/admin-engine.json",
	"id": "core:default",
	"version": 3,
	"title": "Default",
	"description": "Default WP Admin Shell engine. Mirrors the site-editor visual idiom: dark chrome with elevated cards. Ships templates for sidebar, topbar (with start/center/end child regions), main, detail, and overlay; applies a dark chrome background and floats main + detail as elevated white cards.",

	"designSystem": "@wordpress/ui",

	"menu-renderer": "sidebar-tree",

	"specializes-roles": [
		"navigation",
		"banner",
		"main",
		"complementary",
		"dialog",
		"contentinfo"
	],

	"honored-platform": [
		"core:modal",
		"core:dismiss-on",
		"core:autofocus-target",
		"core:triggerable",
		"core:persists-across-navigation",
		"core:dirty-state",
		"core:block-navigation-on-dirty",
		"core:trigger",
		"core:dynamic-children"
	],

	"modes": {
		"default": {
			"label": "Default",
			"description": "Full workspace chrome — sidebar, toolbar, site-hub, content.",
			"regions": {
				"sidebar":  { "hidden": false, "compact": false },
				"toolbar":  { "hidden": false, "compact": false },
				"site-hub": { "hidden": false },
				"content":  { "hidden": false, "fullWidth": false },
				"preview":  { "hidden": false }
			}
		},
		"focus": {
			"label": "Focus",
			"description": "Strip the sidebar; compress the toolbar to a back link + save indicator. Editor and authoring surfaces.",
			"regions": {
				"sidebar":  { "hidden": true },
				"toolbar":  { "compact": true },
				"site-hub": { "hidden": false },
				"content":  { "hidden": false, "fullWidth": true },
				"preview":  { "hidden": true }
			}
		},
		"takeover": {
			"label": "Takeover",
			"description": "All workspace chrome hidden. Full-viewport screen. Customizer, full-screen apps.",
			"regions": {
				"sidebar":  { "hidden": true },
				"toolbar":  { "hidden": true },
				"site-hub": { "hidden": true },
				"content":  { "hidden": false, "fullWidth": true },
				"preview":  { "hidden": true }
			}
		},
		"modal": {
			"label": "Modal Overlay",
			"description": "Mount as overlay on top of the current screen. Chrome state of underlying screen unchanged.",
			"modal": true
		}
	},

	"templates": {
		"core:sidebar": {
			"role": "navigation",
			"platform": { "core:persists-across-navigation": true },
			"default-style": {
				"display": "flex",
				"flex-direction": "column",
				"flex-shrink": "0",
				"inline-size": "var(--wp-admin-shell--chrome--sidebar--width, 280px)",
				"block-size": "100%",
				"overflow-y": "auto",
				"overflow-x": "hidden",
				"background": "var(--wp-admin-shell--chrome--sidebar--background, var(--wpds-color-bg-surface-neutral))",
				"color": "var(--wp-admin-shell--chrome--sidebar--foreground, var(--wpds-color-fg-content-neutral))",
				"padding-block": "var(--wp-admin-shell--chrome--sidebar--padding-block, var(--wpds-dimension-padding-md))",
				"padding-inline": "var(--wp-admin-shell--chrome--sidebar--padding-inline, var(--wpds-dimension-padding-md))"
			}
		},

		"core:topbar": {
			"role": "banner",
			"platform": { "core:persists-across-navigation": true },
			"default-style": {
				"display": "flex",
				"align-items": "center",
				"flex-shrink": "0",
				"inline-size": "100%",
				"background": "var(--wp-admin-shell--chrome--toolbar--background, var(--wpds-color-bg-surface-neutral))",
				"color": "var(--wp-admin-shell--chrome--toolbar--foreground, var(--wpds-color-fg-content-neutral))",
				"border-block-end": "1px solid var(--wp-admin-shell--chrome--toolbar--border, var(--wpds-color-stroke-surface-neutral))",
				"padding-block": "var(--wp-admin-shell--chrome--toolbar--padding-block, var(--wpds-dimension-padding-sm))",
				"padding-inline": "var(--wp-admin-shell--chrome--toolbar--padding-inline, var(--wpds-dimension-padding-lg))"
			},
			"regions": {
				"start": {
					"role": "region",
					"default-style": {
						"display": "flex",
						"align-items": "center"
					}
				},
				"center": {
					"role": "region",
					"default-style": {
						"display": "flex",
						"align-items": "center"
					}
				},
				"end": {
					"role": "region",
					"default-style": {
						"display": "flex",
						"align-items": "center",
						"margin-inline-start": "auto"
					}
				}
			}
		},

		"core:main": {
			"role": "main",
			"default-style": {
				"display": "flex",
				"flex-direction": "column",
				"flex": "1",
				"min-inline-size": "0",
				"overflow-y": "auto",
				"overflow-x": "hidden",
				"background": "var(--wp-admin-shell--chrome--content--card-background, var(--wpds-color-bg-surface-neutral))",
				"border-radius": "var(--wpds-border-radius-lg)",
				"box-shadow": "var(--wpds-elevation-sm)",
				"margin": "var(--wpds-dimension-padding-lg) var(--wpds-dimension-padding-lg) var(--wpds-dimension-padding-lg) 0"
			}
		},

		"core:detail": {
			"role": "complementary",
			"platform": { "core:dismiss-on": [ "Escape" ] },
			"default-style": {
				"display": "flex",
				"flex-direction": "column",
				"inline-size": "min(720px, 50%)",
				"min-inline-size": "320px",
				"block-size": "100%",
				"overflow-y": "auto",
				"overflow-x": "hidden",
				"background": "var(--wp-admin-shell--chrome--detail--card-background, var(--wpds-color-bg-surface-neutral-strong))",
				"border-radius": "var(--wpds-border-radius-lg)",
				"box-shadow": "var(--wpds-elevation-sm)",
				"margin": "var(--wpds-dimension-padding-lg) var(--wpds-dimension-padding-lg) var(--wpds-dimension-padding-lg) 0"
			}
		},

		"core:dashboard-grid": {
			"role": "region",
			"platform": { "core:dynamic-children": true },
			"default-style": {
				"display": "block",
				"inline-size": "100%",
				"block-size": "100%",
				"overflow": "auto"
			}
		},

		"core:overlay": {
			"role": "dialog",
			"platform": {
				"core:modal": true,
				"core:dismiss-on": [ "Escape", "backdrop-click" ]
			},
			"default-style": {
				"inline-size": "min(600px, 90vw)",
				"max-block-size": "70vh",
				"position": "fixed",
				"inset-block-start": "20vh",
				"inset-inline-start": "50%",
				"translate": "-50% 0"
			}
		}
	},

	"default-arrangement": "wp-chrome",

	"script": "wp-admin-shell",
	"style": "wp-admin-shell",

	"styles": [
		{
			"handle": "wp-admin-shell-wpds-tokens",
			"src": "build/wpds-tokens.css"
		},
		{
			"handle": "wp-admin-shell-dataviews",
			"src": "build/dataviews.css",
			"deps": [ "wp-components" ]
		}
	],

	"default-styles": {
		"theme": {
			"color": {
				"primary": "#3858E9",
				"bg": "#fafafa"
			},
			"density": "default"
		}
	},

	"defaultRegions": {
		"sidebar": {
			"template": "core:sidebar",
			"regions": {
				"hub": {
					"role": "region",
					"app": "core:site-hub"
				},
				"nav": {
					"role": "navigation",
					"app": "core:navigation"
				}
			}
		},
		"content": {
			"template": "core:main",
			"routing": { "route-key": "_self" }
		},
		"detail": {
			"template": "core:detail",
			"routing": { "route-key": "detail", "mode": "mirror" }
		},
		"command-palette": {
			"template": "core:overlay",
			"routing": { "route-key": "palette" },
			"platform": {
				"core:triggerable": true,
				"core:trigger": { "shortcut": "Mod+K" }
			}
		},
		"notices-banner": {
			"role": "region",
			"app": "core:notices-banner"
		},
		"notices-snackbar": {
			"role": "region",
			"app": "core:notices-snackbar"
		}
	}
}