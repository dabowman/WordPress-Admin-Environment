{
	"$schema": "../../../../docs/schemas/workspace-engine.json",
	"id": "core:desktop",
	"version": 3,
	"title": "Desktop",
	"description": "Desktop-OS engine. Admin screens open as draggable, resizable windows in a wallpapered workspace, with a dock built from the resolved workspace.json navigation. Ports the desktop-mode UX onto the WP Admin Workspaces kernel via the `core:dynamic-children` platform service (spec §5.5) — windows are runtime-mutated child regions of the workspace region, so per-window routing, dirty-state, triggerStore, and capability gating fall out of region-ID nesting with no engine-specific plumbing.",

	"designSystem": "@wordpress/ui",

	"menu-renderer": "dock",

	"specializes-roles": [
		"main",
		"navigation",
		"presentation",
		"region",
		"dialog"
	],

	"honored-platform": [
		"core:modal",
		"core:dismiss-on",
		"core:autofocus-target",
		"core:triggerable",
		"core:persists-across-navigation",
		"core:dirty-state",
		"core:block-navigation-on-dirty",
		"core:trigger",
		"core:dynamic-children"
	],

	"modes": {
		"default": {
			"label": "Default",
			"description": "Wallpapered workspace + dock; windows mount as runtime child regions.",
			"regions": {
				"workspace": { "hidden": false, "fullWidth": false },
				"dock":      { "hidden": false, "compact": false, "pinned": true },
				"wallpaper": { "hidden": false }
			}
		},
		"focus": {
			"label": "Focus",
			"description": "Collapse the dock to a hover-revealed strip so the active window owns the viewport.",
			"regions": {
				"workspace": { "fullWidth": true },
				"dock":      { "compact": true, "pinned": false },
				"wallpaper": { "hidden": false }
			}
		},
		"takeover": {
			"label": "Takeover",
			"description": "Full viewport — dock + wallpaper hidden.",
			"regions": {
				"workspace": { "fullWidth": true },
				"dock":      { "hidden": true },
				"wallpaper": { "hidden": true }
			}
		},
		"modal": {
			"label": "Modal Overlay",
			"description": "Overlay window with engine-managed LIFO stack.",
			"modal": true
		}
	},

	"templates": {
		"core:desktop-workspace": {
			"role": "main",
			"platform": { "core:dynamic-children": true },
			"default-style": {
				"position": "relative",
				"flex": "1 1 auto",
				"inline-size": "100%",
				"block-size": "100%",
				"min-inline-size": "0",
				"min-block-size": "0",
				"overflow": "hidden"
			}
		},

		"core:desktop-dock": {
			"role": "navigation",
			"platform": { "core:persists-across-navigation": true },
			"default-style": {
				"display": "flex",
				"flex-direction": "row",
				"align-items": "center",
				"justify-content": "center",
				"gap": "var(--wp-admin-workspaces--chrome--dock--gap, 8px)",
				"padding-block": "var(--wp-admin-workspaces--chrome--dock--padding-block, 8px)",
				"padding-inline": "var(--wp-admin-workspaces--chrome--dock--padding-inline, 16px)",
				"background": "var(--wp-admin-workspaces--chrome--dock--background, rgba(20, 20, 30, 0.6))",
				"backdrop-filter": "blur(16px)",
				"border-radius": "var(--wp-admin-workspaces--chrome--dock--radius, 16px)",
				"color": "var(--wp-admin-workspaces--chrome--dock--foreground, #fff)"
			}
		},

		"core:desktop-wallpaper": {
			"role": "presentation",
			"default-style": {
				"position": "absolute",
				"inset": "0",
				"z-index": "0",
				"background": "var(--wp-admin-workspaces--chrome--wallpaper--background, linear-gradient(135deg, #1e3a5f 0%, #2d5985 100%))",
				"pointer-events": "none"
			}
		}
	},

	"default-arrangement": "desktop-windows",

	"default-styles": {
		"chrome": {
			"canvas": {
				"background": "#0a0a1a",
				"foreground": "#f0f0f5"
			},
			"wallpaper": {
				"background": "linear-gradient(135deg, #1e3a5f 0%, #2d5985 100%)"
			},
			"dock": {
				"background": "rgba(20, 20, 30, 0.6)",
				"foreground": "#ffffff",
				"gap": "8px",
				"padding-block": "8px",
				"padding-inline": "16px",
				"radius": "16px",
				"offset-block-end": "24px"
			},
			"window-frame": {
				"background": "#2a2a3a",
				"foreground": "#f0f0f5",
				"border": "#404050",
				"body-background": "#1c1c28",
				"body-foreground": "#f0f0f5",
				"shadow": "0 8px 24px rgba(0, 0, 0, 0.5)"
			},
			"snap-ghost": {
				"background": "rgba(90, 160, 255, 0.18)",
				"border": "rgba(90, 160, 255, 0.9)"
			}
		}
	},

	"script": "wp-admin-workspaces-engine-core-desktop",

	"defaultRegions": {
		"wallpaper": {
			"template": "core:desktop-wallpaper"
		},
		"workspace": {
			"template": "core:desktop-workspace",
			"routing": { "route-key": "_self" }
		},
		"dock": {
			"template": "core:desktop-dock",
			"app": "core:desktop-dock-app"
		},
		"command-palette": {
			"role": "dialog",
			"label": "Command palette",
			"routing": { "route-key": "palette" },
			"platform": {
				"core:modal": true,
				"core:dismiss-on": [ "Escape", "backdrop-click" ],
				"core:triggerable": true,
				"core:trigger": { "shortcut": "Mod+K" }
			}
		},
		"notices-banner": {
			"role": "region",
			"app": "core:notices-banner"
		},
		"notices-snackbar": {
			"role": "region",
			"app": "core:notices-snackbar"
		}
	}
}
