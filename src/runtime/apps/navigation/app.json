{
  "$schema": "../../../../docs/schemas/admin-app-v2.json",
  "id": "core:navigation",
  "version": 1,
  "title": "Navigation",
  "description": "Recursive sidebar navigation with capability-prune, drill-down screens, and group/separator items.",
  "role": "navigation",
  "platform": {
    "persists-across-navigation": true
  },
  "config-schema": {
    "type": "object",
    "properties": {
      "items":       { "type": "array" },
      "collapsed":   { "type": "boolean" },
      "title":       { "type": "string" },
      "description": { "type": "string" }
    },
    "additionalProperties": false
  },
  "script": "wp-admin-shell"
}
