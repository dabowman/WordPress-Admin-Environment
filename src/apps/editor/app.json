{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:editor",
	"version": 1,
	"title": "Editor",
	"description": "Full block editor for posts and pages. Currently mounts via iframe adapter on post.php; v2 native mount in flight.",
	"designSystem": "@wordpress/ui",
	"role": "main",
	"platform": {
		"core:dirty-state": true,
		"core:block-navigation-on-dirty": true
	},
	"config-schema": {
		"type": "object",
		"properties": {
			"postType": {
				"type": "string",
				"default": "post"
			}
		},
		"additionalProperties": false
	},
	"script": "wp-admin-shell",
	"window": {
		"defaultSize": {
			"w": 1200,
			"h": 820
		},
		"minSize": {
			"w": 640,
			"h": 480
		},
		"multiInstance": true,
		"icon": "edit"
	}
}
