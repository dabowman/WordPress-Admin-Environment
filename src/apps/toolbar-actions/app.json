{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:toolbar-actions",
	"version": 1,
	"title": "Toolbar actions",
	"description": "Topbar action group rendering left/right anchor buttons. Bridges legacy command/app shapes via COMMAND_HREFS.",
	"designSystem": "@wordpress/ui",
	"role": "region",
	"platform": {
		"core:persists-across-navigation": true
	},
	"config-schema": {
		"type": "object",
		"properties": {
			"left": {
				"type": "array"
			},
			"right": {
				"type": "array"
			}
		},
		"additionalProperties": false
	},
	"script": "wp-admin-shell"
}
