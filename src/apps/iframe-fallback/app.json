{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:iframe-fallback",
	"version": 1,
	"title": "Iframe fallback",
	"description": "Wraps any wp-admin URL inside the shell. Chrome hidden via injected CSS.",
	"designSystem": "@wordpress/ui",
	"role": "main",
	"config-schema": {
		"type": "object",
		"properties": {
			"url": {
				"type": "string"
			}
		},
		"additionalProperties": true
	},
	"script": "wp-admin-shell",
	"window": {
		"defaultSize": {
			"w": 1024,
			"h": 720
		},
		"minSize": {
			"w": 540,
			"h": 400
		},
		"multiInstance": true,
		"icon": "external"
	}
}
