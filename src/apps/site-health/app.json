{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:site-health",
	"version": 1,
	"title": "Site Health",
	"description": "Runs WordPress's `/wp-site-health/v1/tests/{id}` async checks and reports results.",
	"designSystem": "@wordpress/ui",
	"role": "main",
	"capabilities": [
		"view_site_health_checks"
	],
	"config-schema": {
		"type": "object",
		"additionalProperties": false
	},
	"script": "wp-admin-shell",
	"window": {
		"defaultSize": {
			"w": 900,
			"h": 720
		},
		"minSize": {
			"w": 540,
			"h": 480
		},
		"multiInstance": false,
		"icon": "wordpress"
	}
}
