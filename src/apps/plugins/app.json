{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:plugins",
	"version": 1,
	"title": "Plugins",
	"description": "DataViews plugin manager: list, activate, deactivate. Reads via `core-data` `'root','plugin'` entity.",
	"designSystem": "@wordpress/ui",
	"role": "main",
	"capabilities": [
		"activate_plugins"
	],
	"config-schema": {
		"type": "object",
		"additionalProperties": false
	},
	"script": "wp-admin-shell",
	"window": {
		"defaultSize": {
			"w": 1024,
			"h": 680
		},
		"minSize": {
			"w": 540,
			"h": 400
		},
		"multiInstance": false,
		"icon": "plugins"
	}
}
