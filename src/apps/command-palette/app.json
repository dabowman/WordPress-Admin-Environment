{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:command-palette",
	"version": 1,
	"title": "Command palette",
	"description": "Cmd+K command palette. Signs commands into `@wordpress/commands`; derives palette entries from the routes block.",
	"designSystem": "@wordpress/ui",
	"role": "dialog",
	"platform": {
		"core:modal": true,
		"core:triggerable": true,
		"core:dismiss-on": [
			"Escape",
			"backdrop-click"
		],
		"core:autofocus-target": "input[type=\"search\"], input[type=\"text\"]"
	},
	"config-schema": {
		"type": "object",
		"additionalProperties": false
	},
	"script": "wp-admin-shell"
}
