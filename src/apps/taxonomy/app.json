{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:taxonomy",
	"version": 1,
	"title": "Taxonomy",
	"description": "DataViews term manager for any taxonomy. `config.taxonomy` selects which taxonomy to manage; defaults to `category`.",
	"designSystem": "@wordpress/ui",
	"role": "main",
	"config-schema": {
		"type": "object",
		"properties": {
			"taxonomy": {
				"type": "string",
				"default": "category"
			},
			"title": {
				"type": "string"
			}
		},
		"additionalProperties": false
	},
	"script": "wp-admin-shell",
	"window": {
		"defaultSize": {
			"w": 960,
			"h": 680
		},
		"minSize": {
			"w": 480,
			"h": 360
		},
		"multiInstance": true,
		"icon": "tag"
	}
}
