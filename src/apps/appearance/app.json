{
	"$schema": "../../../docs/schemas/admin-app-v2.json",
	"id": "core:appearance",
	"version": 1,
	"title": "Appearance",
	"description": "User-prefs UI driven by the `customizable` field. Per-user overrides persist via `/wp-admin-shell/v1/user-prefs`.",
	"designSystem": "@wordpress/ui",
	"role": "main",
	"config-schema": {
		"type": "object",
		"additionalProperties": false
	},
	"script": "wp-admin-shell",
	"window": {
		"defaultSize": {
			"w": 720,
			"h": 600
		},
		"minSize": {
			"w": 480,
			"h": 360
		},
		"multiInstance": false,
		"icon": "page"
	}
}
